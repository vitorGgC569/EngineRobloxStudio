# ================================ secrets ===================================
# `docs/goal/key.txt` holds a real Roblox account key. Rather than name one
# file, every .txt is excluded: the loose notes in this project are where
# credentials get pasted, and a rule that only covers the leak you already know
# about does not cover the next one.
#
# A .txt that genuinely belongs in the repository can be added with
# `git add -f`, which forces the decision to be deliberate.
*.txt
docs/goal/

# ============================== build outputs ===============================
# Place files are produced by `rojo build` / `forge build` from the project
# json plus src/. Every one of them sits next to the source that generates it,
# so committing them means storing the same content twice and reviewing a
# 500KB XML diff on every gameplay change.
*.rbxlx
*.rbxl
*.rbxm

# =============================== scratch ====================================
# Working directory for the pipeline. Currently the largest thing on disk by a
# wide margin, and none of it is source.
.tmp/
.rqe/

# ============================= vendored tools ===============================
# The pinned Luau compiler and analyzer are downloaded binaries, not code.
# The tooling fetches them on demand; a git repository is the wrong place for
# a multi-megabyte executable per platform.
.tools/

# ================================ python ====================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =============================== editors/OS =================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# ============================== agent-local =================================
# Shared project configuration is worth committing; per-machine overrides and
# session state are not.
.claude/settings.local.json
.claude/sessions/
.codex/sessions/

# ============================== run artefacts ===============================
# Screenshots, audit reports and release runs. Each release run is an
# immutable directory holding its own built place, its evidence and its logs —
# megabytes per run, regenerated by `forge quality`, and meaningless outside
# the machine that produced it. The generated *contract* is source and stays;
# what the contract produced is not.
artifacts/
reports/
