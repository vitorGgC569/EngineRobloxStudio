      "repetition": {"maximumIdenticalVariantRun": 4, "minimumVariantEntropy": 0.7}
    },
    "plot": {
      "density": {
        "minimumRootsPer1000SquareStuds": 0.8,
        "maximumRootsPer1000SquareStuds": 18,
        "minimumFootprintCoverage": 0.1
      },
      "heightVariation": {"minimumP90MinusP10": 3, "maximumP90MinusP10": 70},
      "materialVariety": {"minimumDistinctMaterials": 3, "maximumDominantFraction": 0.78},
      "repetition": {"maximumIdenticalVariantRun": 5, "minimumVariantEntropy": 0.5}
    },
    "mine": {
      "density": {
        "minimumRootsPer1000SquareStuds": 1,
        "maximumRootsPer1000SquareStuds": 24,
        "minimumFootprintCoverage": 0.15
      },
      "heightVariation": {"minimumP90MinusP10": 6, "maximumP90MinusP10": 100},
      "materialVariety": {"minimumDistinctMaterials": 4, "maximumDominantFraction": 0.75},
      "repetition": {"maximumIdenticalVariantRun": 4, "minimumVariantEntropy": 0.65}
    }
  },
  "regionSets": {
    "hub-regions": {
      "selector": {"tag": "RQEVisualRegion", "attributeEquals": {"VisualRegionProfile": "hub"}},
      "profile": "hub",
      "minimumRegions": 1,
