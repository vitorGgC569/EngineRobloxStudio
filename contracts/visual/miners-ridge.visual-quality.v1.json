    "plot-regions": {
      "selector": {"tag": "RQEVisualRegion", "attributeEquals": {"VisualRegionProfile": "plot"}},
      "profile": "plot",
      "minimumRegions": 4,
      "maximumRegions": 8,
      "minimumProfileCoverage": 1
