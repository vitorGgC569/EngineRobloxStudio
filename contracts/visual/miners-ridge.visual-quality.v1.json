{
  "$schema": "../../schemas/visual-quality-spec.v1.schema.json",
  "schemaVersion": 1,
  "specId": "miners-ridge.visual-quality",
  "revision": 1,
  "units": {
    "distance": "stud",
    "density": "visualRootsPer1000SquareStuds",
    "colorDifference": "CIEDE2000"
  },
  "classification": {
    "candidateTag": "RQEVisualCandidate",
    "rootTag": "RQEVisualRoot",
    "typeAttribute": "VisualType",
    "variantAttribute": "VisualVariant",
    "assetKeyAttribute": "AssetKey",
    "regionTag": "RQEVisualRegion",
    "regionProfileAttribute": "VisualRegionProfile",
    "landmarkTag": "RQELandmark",
    "landmarkAnchorTag": "RQELandmarkAnchor",
    "excludeTag": "RQEVisualExclude",
    "minimumClassifiedFraction": 0.98
  },
  "palette": {
    "swatches": [
      {"id": "grass", "rgb": [115, 198, 88], "roles": ["ground", "nature"]},
      {"id": "grass-dark", "rgb": [88, 170, 68], "roles": ["ground", "shadow"]},
      {"id": "path-red", "rgb": [226, 92, 82], "roles": ["path", "accent"]},
      {"id": "path-white", "rgb": [240, 240, 236], "roles": ["path", "surface"]},
      {"id": "trim-gold", "rgb": [248, 208, 74], "roles": ["accent", "reward"]},
      {"id": "pavement", "rgb": [214, 214, 208], "roles": ["ground", "structure"]},
      {"id": "brick", "rgb": [206, 176, 138], "roles": ["structure", "warm"]},
      {"id": "brick-dark", "rgb": [151, 116, 82], "roles": ["structure", "shadow"]},
      {"id": "wood", "rgb": [132, 90, 61], "roles": ["structure", "prop"]},
      {"id": "stone", "rgb": [128, 133, 140], "roles": ["structure", "mine"]},
      {"id": "slate", "rgb": [57, 65, 78], "roles": ["roof", "shadow"]},
      {"id": "ink", "rgb": [31, 37, 49], "roles": ["text", "outline"]},
      {"id": "metal", "rgb": [157, 164, 174], "roles": ["machine", "structure"]},
      {"id": "white", "rgb": [248, 248, 245], "roles": ["surface", "text"]},
      {"id": "leaf", "rgb": [58, 143, 72], "roles": ["nature", "vegetation"]}
    ],
    "maximumDeltaE": 18,
    "maximumOffPaletteFraction": 0.05
  },
  "objectTypes": {
    "building": {
      "selector": {"tag": "RQEVisualRoot", "attributeEquals": {"VisualType": "building"}},
      "minimumInstances": 4,
      "maximumInstances": 24,
      "scale": {
        "boundsMethod": "oriented-box",
        "minimumSize": [8, 6, 8],
        "maximumSize": [120, 100, 120],
        "maximumRelativeMad": 0.85,
        "groupByAttribute": "VisualVariant"
      }
    },
    "interactive": {
      "selector": {"tag": "RQEVisualRoot", "attributeEquals": {"VisualType": "interactive"}},
      "minimumInstances": 5,
      "maximumInstances": 80,
      "scale": {
        "boundsMethod": "oriented-box",
        "minimumSize": [0.5, 0.5, 0.5],
        "maximumSize": [32, 32, 32],
        "maximumRelativeMad": 0.7,
        "groupByAttribute": "VisualVariant"
      }
    },
    "vegetation": {
      "selector": {"tag": "RQEVisualRoot", "attributeEquals": {"VisualType": "vegetation"}},
      "minimumInstances": 12,
      "maximumInstances": 300,
      "scale": {
        "boundsMethod": "oriented-box",
        "minimumSize": [0.5, 1, 0.5],
        "maximumSize": [36, 60, 36],
        "maximumRelativeMad": 0.65,
        "groupByAttribute": "VisualVariant"
      }
    }
  },
  "regionProfiles": {
    "hub": {
      "density": {
        "minimumRootsPer1000SquareStuds": 1.2,
        "maximumRootsPer1000SquareStuds": 20,
        "minimumFootprintCoverage": 0.12
