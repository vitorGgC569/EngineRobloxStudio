    "mine-regions": {
      "selector": {"tag": "RQEVisualRegion", "attributeEquals": {"VisualRegionProfile": "mine"}},
      "profile": "mine",
      "minimumRegions": 1,
      "maximumRegions": 3,
      "minimumProfileCoverage": 1
    }
