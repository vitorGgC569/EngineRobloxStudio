            <Item class="Script" referent="20743">
              <Properties>
                <string name="Name">Script</string>
                <BinaryString name="AttributesSerialize">
                </BinaryString>
                <bool name="Disabled">false</bool>
                <Content name="LinkedSource">
                  <null>
                  </null>
                </Content>
                <string name="ScriptGuid">{e26a9671-b23a-4141-b2c5-cf3280b7bdcc}</string>
                <string name="Source">print("Adding Trigger script to Big Head!")

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')

local part=script.Parent
local light=part.Parent.light.PointLight

local monster=part.Parent.monster
local sound = monster.Head.Sound

light.Enabled=false

function isHuman(hit)
	if hit.Parent == nil then
		return false
	end
	local humanoid = hit.Parent:FindFirstChild('HumanoidRootPart')
	if humanoid then
		return true
	end
	
	return false
end

function getPlayer(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	return player
end

local originalCf=monster.HumanoidRootPart.CFrame

function moveMonster(character)
	
	
	local PartToMove = monster.HumanoidRootPart
	local info =  TweenInfo.new(
		2, -- Time
		Enum.EasingStyle.Bounce, -- EasingStyle
		Enum.EasingDirection.Out, -- Easing Direction
		1, -- Repeat Count
		true, -- Reverses to initial position? (true/false)
		0.5 -- Delay between each tween.
	)
	local goals = {
		Position = character.HumanoidRootPart.Position
	}
	local Tween = TweenService:Create(PartToMove, info, goals)
	Tween:Play()
	Tween.Completed:Connect(function()
		monster.HumanoidRootPart.CFrame =  originalCf
		return
	end)
end

local flickering = false

function flickerLight(character)
	flickering = true
	sound:Play()
	
	spawn(function()
		moveMonster(character)
		wait(5)
		warn('flickering stop')
		flickering=false
	end)
	
	while flickering do
		warn('flickering')
		light.Enabled=true
		wait(math.random(1,10)/20)
		light.Enabled=false
		wait(math.random(1,10)/20)
	end
	

	
end


local function onTouchStart(hit)
	if isHuman(hit) and getPlayer(hit) and not flickering then
		warn('touch', hit.Name)
		flickerLight(hit.Parent)
		
	end
end

part.Touched:Connect(onTouchStart)
