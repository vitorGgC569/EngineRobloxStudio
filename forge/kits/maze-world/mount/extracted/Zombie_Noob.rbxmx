--		playAnimation(emote, 0.1, Humanoid)
--	end
--	print("===&gt; " .. string.sub(msg, 1, 3) .. "(" .. emote .. ")")
--end)


-- main program

local runService = game:service("RunService");

-- print("bottom")

-- initialize to idle
playAnimation("idle", 0.1, Humanoid)
pose = "Standing"

while Figure.Parent~=nil do
	local _, time = wait(0.1)
	move(time)
end


