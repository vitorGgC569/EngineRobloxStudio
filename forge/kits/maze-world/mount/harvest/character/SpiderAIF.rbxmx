							<Item class="Script" referent="RBXc4b96657fec745fbaa057a180173ed59">
								<Properties>
									<BinaryString name="AttributesSerialize" />
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null /></Content>
									<string name="Name">Pathfinding</string>
									<string name="ScriptGuid">{f1608375-3138-49d8-9744-5038d2d90bd3}</string>
									<ProtectedString name="Source">

--
local PathfindingService = game:GetService("PathfindingService")
local humanoid = script.Parent.Parent:WaitForChild("Humanoid")

targetV = script.Parent:WaitForChild("Target")

local WanderX, WanderZ = 110, 110


local hroot = script.Parent.Parent:WaitForChild("HumanoidRootPart")
local origPos= hroot.Position


function getRandomPoint()


	local desgx, desgz = origPos.x + math.random(-WanderX,WanderX), origPos.z + math.random(-WanderZ,WanderZ)


	local point= Vector3.new(desgx, origPos.y, desgz)


	--warn('New point:', point)
	return point
end



local currentWaypointIndex=0
local waypoints

--warn('Calc spider path')
local path = PathfindingService:CreatePath()

local destinationPos

local function followPath(destinationPos)
	-- Compute and check the path
	path:ComputeAsync(hroot.Position, destinationPos)
	-- Empty waypoints table after each new path computation
	waypoints = {}

	if path.Status == Enum.PathStatus.Success then
		-- Get the path waypoints and start zombie walking
		waypoints = path:GetWaypoints()

		-- Move to first waypoint
		currentWaypointIndex = 1
		humanoid:MoveTo(waypoints[currentWaypointIndex].Position)
	else
		-- Error (path not found); stop humanoid
		--warn('Path not found')
		destinationPos = getRandomPoint()
		followPath(destinationPos)
	end
end

local function onWaypointReached(reached)


	if reached and currentWaypointIndex &lt; #waypoints then
		currentWaypointIndex = currentWaypointIndex + 1
		humanoid:MoveTo(waypoints[currentWaypointIndex].Position)
	elseif reached and currentWaypointIndex == #waypoints then
		destinationPos = getRandomPoint()
		--warn('New random point')
		followPath(destinationPos)

	end

end


-----------------

if  humanoid.Torso then

	destinationPos = getRandomPoint()

	local function onPathBlocked(blockedWaypointIndex)
		-- Check if the obstacle is further down the path
		if blockedWaypointIndex &gt; currentWaypointIndex then
			-- Call function to re-compute the path
			followPath(destinationPos)
		end
	end




	-- Connect 'Blocked' event to the 'onPathBlocked' function
	path.Blocked:Connect(onPathBlocked)

	-- Connect 'MoveToFinished' event to the 'onWaypointReached' function
	humanoid.MoveToFinished:Connect(onWaypointReached)


	followPath(destinationPos)
end
