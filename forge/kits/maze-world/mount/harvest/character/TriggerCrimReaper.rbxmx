							<Item class="Script" referent="RBX32e1735261414f4c9a1fd79cc11f560c">
								<Properties>
									<BinaryString name="AttributesSerialize" />
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null /></Content>
									<string name="Name">Script</string>
									<string name="ScriptGuid">{73edc43d-214d-4262-a653-f5a20fb918d9}</string>
									<ProtectedString name="Source">print("Adding Trigger script to Crim Reaper!")

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')

local part=script.Parent
local light=part.Parent.light.Light

local monster=part.Parent.monster
local sound = monster.Head.Sound
light.Enabled=false



local enabled = false

function flickerLight(character)
	light.Enabled = true
	sound:Play()
	enabled = true
	
	
	sound.Ended:Connect(function(soundId)
		warn('stopped')
		light.Enabled=false
		enabled = false
	end)	


	while enabled do
		warn('flickering')
		light.Enabled=true
		wait(math.random(1,10)/20)
		light.Enabled=false
		wait(math.random(1,10)/40)
	end
end


local function onTouchStart(hit)
	local plr = game.Players:GetPlayerFromCharacter(hit.Parent)
	if plr and not enabled then
		warn('touch', hit.Name)
		flickerLight(hit.Parent)
	end
end

part.Touched:Connect(onTouchStart)
</ProtectedString>
