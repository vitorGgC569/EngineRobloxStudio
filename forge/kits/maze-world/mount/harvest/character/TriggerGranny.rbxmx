							<Item class="Script" referent="RBXbd4e87f277074fffa9787f40a9fb79e9">
								<Properties>
									<BinaryString name="AttributesSerialize" />
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null /></Content>
									<string name="Name">Script</string>
									<string name="ScriptGuid">{8b16e729-a7cf-43ba-abda-7ac680b2306d}</string>
									<ProtectedString name="Source">print("Adding Trigger script to Granny!")

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')

local part=script.Parent
local light=part.Parent.light.PointLight

local monster=part.Parent.monster
local sound = monster.Head.Sound
light.Enabled=false



local originalCf=monster.HumanoidRootPart.CFrame


local flickering = false

function moveMonster(character)
	local PartToMove = monster.HumanoidRootPart
	local info =  TweenInfo.new(
		7, -- Time
		Enum.EasingStyle.Linear, -- EasingStyle
		Enum.EasingDirection.Out, -- Easing Direction
		1, -- Repeat Count
		true, -- Reverses to initial position? (true/false)
		0.1 -- Delay between each tween.
	)
	local goals = {
		Position = character.HumanoidRootPart.Position
	}
	local Tween = TweenService:Create(PartToMove, info, goals)
	Tween:Play()
	Tween.Completed:Connect(function()
		monster.HumanoidRootPart.CFrame =  originalCf
		flickering=false
		sound:Stop()
		return
	end)
end



function flickerLight(character)
	flickering = true
	sound:Play()

	spawn(function()
		moveMonster(character)
	end)

	while flickering do
		warn('flickering')
		light.Enabled=true
		wait(math.random(1,10)/20)
		light.Enabled=false
		wait(math.random(1,10)/20)
	end
end


local function onTouchStart(hit)
	local plr = game.Players:GetPlayerFromCharacter(hit.Parent)
	if plr and not flickering then
		warn('touch', hit.Name)
		flickerLight(hit.Parent)

	end
end

part.Touched:Connect(onTouchStart)
