							<Item class="Script" referent="RBXff1a08323ae14952ac156f41edb31262">
								<Properties>
									<BinaryString name="AttributesSerialize" />
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null /></Content>
									<string name="Name">Script</string>
									<string name="ScriptGuid">{99939686-6b4b-4a79-903d-48768dbc5811}</string>
									<ProtectedString name="Source">print("Adding Trigger script to Noob!")

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')

local part=script.Parent
local light=part.Parent.light.PointLight

local monster=part.Parent.monster
local sound = monster.Head.Sound
light.Enabled=false

function isHuman(hit)
	if hit.Parent == nil then
		return false
	end
	local humanoid = hit.Parent:FindFirstChild('HumanoidRootPart')
	if humanoid then
		return true
	end

	return false
end

function getPlayer(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	return player
end

local originalPosition=monster.HumanoidRootPart.Position


local flickering = false
function moveMonster(character)
	local PartToMove = monster.Humanoid

	PartToMove:MoveTo(character.HumanoidRootPart.Position)
	PartToMove.MoveToFinished:Wait()
	PartToMove:MoveTo(originalPosition)
	flickering=false
	sound:Stop()
end



function flickerLight(character)
	flickering = true
	sound:Play()

	spawn(function()
		moveMonster(character)

		
	end)

	while flickering do
		warn('flickering')
		light.Enabled=true
		wait(math.random(1,10)/20)
		light.Enabled=false
		wait(math.random(1,10)/20)
	end



end


local function onTouchStart(hit)
	if isHuman(hit) and getPlayer(hit) and not flickering then
		warn('touch', hit.Name)
		flickerLight(hit.Parent)

	end
end

part.Touched:Connect(onTouchStart)
