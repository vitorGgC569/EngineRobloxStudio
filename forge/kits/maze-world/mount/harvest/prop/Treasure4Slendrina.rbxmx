									<ProtectedString name="Source">function waitForChild(a, b)
	local c = a:findFirstChild(b)
	if c then
		return c
	end
	while true do
		c = a.ChildAdded:wait()
		if c.Name == b then
			return c
		end
	end
end
local c = script.Parent
local o = waitForChild(c, 'Zombie')

local animations = {}

function loadAnimation(controller, anim) 

	if not animations[anim] then
		animations[anim] = controller:LoadAnimation(anim)
	end

	return  animations[anim] 

end

