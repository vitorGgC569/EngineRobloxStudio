									<string name="Name">Script</string>
									<string name="ScriptGuid">{ff60ebfe-b1dc-4d12-a473-dae3562010a0}</string>
									<ProtectedString name="Source">print("Adding Trigger script to Charlie head!")

local Players = game:GetService('Players')
local TweenService = game:GetService('TweenService')

local part=script.Parent

local light=part.Parent.light.PointLight
local lavaPart=part.Parent.Lava

local monster=part.Parent.monster
local sound = monster.Head.Sound
light.Enabled=false


local enabled = false


function moveMonster(character)


	local PartToMove = monster.Head
	local info =  TweenInfo.new(
		0.05, -- Time
		Enum.EasingStyle.Linear, -- EasingStyle
		Enum.EasingDirection.Out, -- Easing Direction
		100, -- Repeat Count
		true, -- Reverses to initial position? (true/false)
		0.05 -- Delay between each tween.
	)
	local goals = {
		Position = PartToMove.Position + Vector3.new(0,0,0.1)
	}
	local Tween = TweenService:Create(PartToMove, info, goals)
	


	Tween:Play()

end


function createLavaPart(position, folder)
	local newBlock = lavaPart:Clone()

	newBlock.Anchored = false
	newBlock.Size = Vector3.new(0.5, 0.5, 0.5)
	newBlock.Position = position
	newBlock.Parent = folder
	return newBlock
end

function flickerLight(character)
	enabled = true
	sound:Play()
	
	sound.Ended:Connect(function(soundId)
		
		light.Enabled=false
		enabled = false
	end)	
	
	spawn(function()
		moveMonster()
		
		while enabled do
			
			local part = createLavaPart(monster.Head.Position, monster)
			wait(1)
			part:Destroy()
		end
	end)
	
	while enabled do

		light.Enabled=true
		wait(math.random(1,10)/20)
		light.Enabled=false
		wait(math.random(1,10)/20)
	end
	

	
end


local function onTouchStart(hit)
	local plr = game.Players:GetPlayerFromCharacter(hit.Parent)
	if plr and not enabled then
		warn('touch', hit.Name)
		flickerLight(hit.Parent)
		
	end
end

part.Touched:Connect(onTouchStart)
