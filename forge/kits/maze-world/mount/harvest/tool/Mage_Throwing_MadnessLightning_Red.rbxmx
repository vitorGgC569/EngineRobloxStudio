            <R00>1</R00>
            <R01>0</R01>
            <R02>0</R02>
            <R10>-0</R10>
            <R11>0.70710677</R11>
            <R12>0.70710677</R12>
            <R20>0</R20>
            <R21>-0.70710677</R21>
            <R22>0.70710677</R22>
          </CoordinateFrame>
