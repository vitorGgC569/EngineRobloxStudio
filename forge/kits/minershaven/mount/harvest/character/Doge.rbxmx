            <string name="Name">Follow</string>
            <BinaryString name="Tags" />
            <Ref name="Value">null</Ref>
          </Properties>
        </Item>
        <Item class="Vector3Value" referent="12043">
          <Properties>
            <string name="Name">Offset</string>
            <BinaryString name="Tags" />
            <Vector3 name="Value">
              <X>-3</X>
              <Y>0</Y>
              <Z>-0.5</Z>
            </Vector3>
          </Properties>
        </Item>
        <Item class="ObjectValue" referent="12044">
          <Properties>
            <string name="Name">Target</string>
            <BinaryString name="Tags" />
            <Ref name="Value">null</Ref>
          </Properties>
        </Item>
        <Item class="Vector3Value" referent="12045">
          <Properties>
            <string name="Name">TargetPos</string>
            <BinaryString name="Tags" />
            <Vector3 name="Value">
              <X>0</X>
              <Y>0</Y>
              <Z>0</Z>
            </Vector3>
          </Properties>
        </Item>
        <Item class="NumberValue" referent="12046">
          <Properties>
            <string name="Name">Damage</string>
            <BinaryString name="Tags" />
            <double name="Value">0</double>
          </Properties>
        </Item>
        <Item class="Script" referent="12047">
          <Properties>
            <string name="Name">AIScript</string>
            <bool name="Disabled">false</bool>
            <Content name="LinkedSource">
              <null>
              </null>
