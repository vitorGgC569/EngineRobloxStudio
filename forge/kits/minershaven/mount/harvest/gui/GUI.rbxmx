        <Item class="ModuleScript" referent="2713">
          <Properties>
            <string name="Name">XboxMessage</string>
            <Content name="LinkedSource">
              <null>
              </null>
            </Content>
            <string name="ScriptGuid">{F1F6DDBE-0159-4908-90FF-EDDBA46A97BF}</string>
            <string name="Source">--[[
NOTICE
Copyright (c) 2019 Andrew Bereza
Provided for public use in educational, recreational or commercial purposes under the Apache 2 License.
Please include this copyright &amp; permission notice in all copies or substantial portions of Miner's Haven source code
]]

local module = {}

function module.init(Modules)
	
	local function Close()
		game:GetService("GuiService"):RemoveSelectionGroup("XboxChat")
		game:GetService("GuiService").SelectedObject = nil
		game:GetService("GuiService").GuiNavigationEnabled = false
		script.Parent.Visible = false
		script.Parent.TextBox.Text = ""
	end	
	
	local Debounce = true

	script.Parent.Send.MouseButton1Click:connect(function()
		local Message = script.Parent.TextBox.Text
		if string.len(Message) &gt; 0 then
			local success = game.ReplicatedStorage.SendChat:InvokeServer(Message)
			if success then
				Close()
			else
				script.Parent.Parent.Error:Play()
			end
		end
	end)
end

return module
</string>
            <BinaryString name="Tags" />
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="2714">
        <Properties>
          <string name="Name">Translate</string>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{6E07D16A-89B9-480E-AEBF-23EA7F3BD392}</string>
          <string name="Source">local module = {}

local function normify(str)
	str = string.lower(string.gsub(string.gsub(str," ","_"),"[^a-zA-Z0-9 - _]",""))
	if #str &gt; 30 then
		str = string.sub(str,1,30)
	end
	return str
end

local Translator = game.LocalizationService:GetTranslatorForPlayer(game.Players.LocalPlayer)

local function Translate(RealItem, Type)
	local Text
	local Prefix = "item_"
	if Type == "Name" then
		Prefix = "itemname_"
	end
	pcall(function()
		local Translation = Translator:FormatByKey(Prefix..normify(RealItem.Name))
		if Translation and #Translation &gt; 0 then
			Text = Translation
		end
	end)	
	return Text
end

function module.Item(RealItem)
	return Translate(RealItem,"Description") or RealItem.Description.Value
end

function module.ItemName(RealItem)
	return Translate(RealItem,"Name") or RealItem.Name
end

return module
