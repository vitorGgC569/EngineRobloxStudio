      <Item class="ModuleScript" referent="2633">
        <Properties>
          <string name="Name">Tutorial</string>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{D0682073-5874-47B7-85DA-9E47E8D5DD7D}</string>
          <string name="Source">--[[
NOTICE
