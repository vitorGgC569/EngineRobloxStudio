            <string name="ScriptGuid">{E8944C00-0EDE-405D-AE95-04109CAF3DC0}</string>
            <string name="Source">while true do
	for i=1,50 do
		wait()
		script.Parent.Frame.BackgroundColor3 = Color3.new(i/50,0,0)
	end
	for i=50,0,-1 do
		wait()
		script.Parent.Frame.BackgroundColor3 = Color3.new(i/50,0,0)
	end
end</string>
