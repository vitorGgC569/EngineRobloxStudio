          <string name="ScriptGuid">{C3341E88-C8CD-43B8-81A4-D882076486BE}</string>
          <string name="Source">for i,v in pairs(script.Parent:GetChildren()) do
	if v:IsA("Frame") then
		v.Position = UDim2.new(0,0,-1,0)
	end
end
for i=1,7 do
	wait(0.1)
	script.Parent[tostring(i)]:TweenPosition (
    UDim2.new(0,0,0,0),
    Enum.EasingDirection.InOut,
    Enum.EasingStyle.Quad,
    0.5,
    false,
    nil)
end</string>
          <BinaryString name="Tags" />
        </Properties>
