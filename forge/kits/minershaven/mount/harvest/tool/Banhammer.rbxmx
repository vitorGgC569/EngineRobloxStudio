      <Item class="Script" referent="60914">
        <Properties>
          <string name="Name">MeleeScript</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{0BD0A366-9ABA-43C9-9B5B-34043BD95CA9}</string>
          <string name="Source">local Debounce = true
local Human
local Swing

local Damage = 100
--[[
local function FindTargets(Parts)
	local Targets = {}
	if Parts ~= nil and #Parts &gt; 0 then		
		for i, Part in pairs(Parts) do
			if Part and Part.Parent then
				if Part.Parent:FindFirstChild("Humanoid") and Targets[Part.Parent.Name] == nil and Part.Parent ~= script.Parent.Parent then
					Targets[Part.Parent.Name] = {["Humanoid"] = Part.Parent.Humanoid,["Part"] = Part}
				end				
			end			
		end
	end
	return Targets
end
]]

local InSwing = false

script.Parent.Equipped:connect(function(Mouse)
	local Humanoid = script.Parent.Parent:FindFirstChild("Humanoid")
	if Swing == nil or Humanoid ~= Human then
		
		if Humanoid then
			Human = Humanoid
			Swing = Humanoid:LoadAnimation(script.Parent.Swing)
			Swing.KeyframeReached:connect(function(Key)
				
				if Key == "SwingStart" then
					InSwing = true	
					script.Parent.Handle.Swing:Play()
				elseif Key == "Hit" then
					
					wait(0.1)
					InSwing = false
												
				end
					
			--	end
			end)			
		end
	end
end)

script.Parent.Handle.Touched:connect(function(Hit)
	local Target = Hit.Parent
	if InSwing and Target:FindFirstChild("Humanoid") and Target ~= script.Parent.Parent then
		if Target.Humanoid:FindFirstChild("HitHard") == nil then
			if Target.Humanoid:FindFirstChild("Safe") == nil and Target.Humanoid:FindFirstChild("ForceField") == nil then
				
				Target.Humanoid:TakeDamage(Damage)
				Target.Humanoid.Sit = true
				local OldPower = Target.Humanoid.JumpPower
				Target.Humanoid.JumpPower = 0
				Target.Humanoid.WalkSpeed = Target.Humanoid.WalkSpeed - 10
				spawn(function()
					wait(1)
					if Target.Humanoid then
						Target.Humanoid.JumpPower = OldPower
						Target.Humanoid.WalkSpeed = Target.Humanoid.WalkSpeed + 8
					end
				end)
				
				
				local ExpTarget = Target:FindFirstChild("HumanoidRootPart")	
				
				if ExpTarget == nil then
					ExpTarget = Target:FindFirstChild("Head")
				end				
				
				if ExpTarget then
					local Exp = Instance.new("Explosion",workspace)
					Exp.DestroyJointRadiusPercent = 0
					Exp.Position = ExpTarget.Position
					local Velo = Instance.new("BodyVelocity")
					local dir = script.Parent.Handle.CFrame.lookVector
					local Vect = Vector3.new(dir.X,math.abs(dir.Y),dir.Z) * 250
					Velo.Velocity = Vect
					ExpTarget.Velocity = Vect
					Velo.Parent = ExpTarget
					game.Debris:AddItem(Velo,0.5)
					local Sound = script.Parent.Hit:Clone()
					Sound.Parent = Hit
					Sound:Play()
					game.Debris:AddItem(Sound,1.5)
				end
			end
		

			
			spawn(function()
				wait(0.3)
				local Banned = script.Parent.Banned:Clone()
				Banned.Parent = Hit
				Banned:Play()
				game.Debris:AddItem(Banned,3)
			end)
			
			local Tag = Instance.new("BoolValue")
			Tag.Name = "HitHard"
			Tag.Parent = Target.Humanoid
			game.Debris:AddItem(Tag,0.5)
		end
	end
	

end)

script.Parent.Activated:connect(function()
	if Swing and Debounce then
		Debounce = false
		Swing:Play()
		wait(1)
		Debounce = true
	end
end)
</string>
