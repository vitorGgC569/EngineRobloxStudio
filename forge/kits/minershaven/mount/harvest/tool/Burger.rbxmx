      <Item class="Script" referent="60939">
        <Properties>
          <string name="Name">SandwichScript</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{8BA98288-EFFA-4DE1-AF80-2DEE18AAD779}</string>
          <string name="Source">local Tool = script.Parent;

enabled = true

local function deactivate()
	Tool.Handle.DrinkSound:Stop()
	Tool.GripForward = Vector3.new(-1, 0, 0)
	Tool.GripPos = Vector3.new(-.5, -.1, 0)
	Tool.GripRight = Vector3.new(0, 0, 1)
	Tool.GripUp = Vector3.new(0,1,0)
	enabled = true
end



function onActivated()
	if not enabled  then
		return
	end

	enabled = false
	Tool.GripForward = Vector3.new(-.981, .196, 0)
	Tool.GripPos = Vector3.new(-.5, -0.6, -1.5)
	Tool.GripRight = Vector3.new(0, -0, -1)
	Tool.GripUp = Vector3.new(0.196, .981, 0)


	Tool.Handle.DrinkSound:Play()

	wait(70)
	
	deactivate()

end

function onEquipped()
	Tool.Handle.OpenSound:play()
end

script.Parent.Unequipped:connect(deactivate)

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</string>
          <BinaryString name="Tags" />
        </Properties>
