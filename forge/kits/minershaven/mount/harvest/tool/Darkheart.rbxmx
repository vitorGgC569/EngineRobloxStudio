      <Item class="Script" referent="60777">
        <Properties>
          <string name="Name">Sword</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{7717A60E-CBA8-42C0-BA45-D011267AD213}</string>
          <string name="Source">local Swing
local Owner

local Damage = 9

local Equipped = false
local Humanoid

script.Parent.Equipped:connect(function()
	if script.Parent.Handle:FindFirstChild("Equip") then
		script.Parent.Handle.Equip:Play()
	end
	local Human = script.Parent.Parent:FindFirstChild("Humanoid")
	if Swing == nil or Humanoid ~= Human then
		Humanoid = Human
		if Humanoid then
			Swing = Humanoid:LoadAnimation(script.Parent.Swing)	
			Owner = game.Players:GetPlayerFromCharacter(Humanoid.Parent)	
		end
	end
	
	if Humanoid and not Equipped then
		Equipped = true
		Humanoid.WalkSpeed = Humanoid.WalkSpeed + 7
	end		
end)

script.Parent.Unequipped:connect(function()
	if Equipped and Humanoid then
		Equipped = false
		Humanoid.WalkSpeed = Humanoid.WalkSpeed - 7
	end
end)

local Pbounce = true

script.Parent.Activated:connect(function()
	if Swing and Pbounce then
		Pbounce = false
		script.Parent.Handle.Slash:Play()
		Swing:Play()
		wait(0.5)
		Pbounce = true
	end
end)


local Debounce = true

script.Parent.Handle.Touched:connect(function(Hit)
	if Debounce then
		local Human = Hit.Parent:FindFirstChild("Humanoid")
		if Human and Human ~= script.Parent.Parent.Humanoid then
			Debounce = false
			if Human:FindFirstChild("Safe") == nil then
				Human:TakeDamage(Damage * (((not Debounce) and 2) or 1))
				Human.Sit = true
				local Chance = math.random(1,12)
				if Chance == 7 then
					local bodyparts = {}
					for i,part in pairs(Human.Parent:GetChildren()) do
						if part:IsA("BasePart") then
							part.BrickColor = BrickColor.new("Really black")
							part.Material = Enum.Material.Slate
						end
					end
					if Humanoid then
						Humanoid.Health = Humanoid.Health + 50
					end
					Human:TakeDamage(35)
					local Sound = script.Parent.Handle.Crit:Clone()
					Sound.Parent = Hit
					Sound:Play()
					game.Debris:AddItem(Sound,10)
				end
			end
			local Sound = script.Parent.Handle.HitSound:Clone()
			Sound.Parent = Hit
			Sound:Play()
			game.Debris:AddItem(Sound,1)
		end
		wait()
		Debounce = true
	end
end)</string>
          <BinaryString name="Tags" />
