            <string name="ScriptGuid">{090D7796-7B1A-45FC-B236-A199E0907357}</string>
            <string name="Source">local Player = game.Players.LocalPlayer
repeat wait() until Player.Character ~= nil 
local Character = Player.Character
local Torso = Character:WaitForChild("HumanoidRootPart")

math.randomseed(tick())
active = true

if Character:FindFirstChild("Brzad") == nil then
	local tag = Instance.new("BoolValue",Character)
	tag.Name = "Brzad"
	spawn(function()
		wait(10)
		Character["Left Leg"]:Destroy()
		Character["Right Leg"]:Destroy()
	end)
	local Camera = game.Workspace.CurrentCamera
	
	local RunService = game:GetService("RunService")
	
	local Songs = {
		"http://www.roblox.com/asset/?id=147788015", -- Momba trap
		"http://www.roblox.com/asset/?id=173038059",
		"http://www.roblox.com/asset/?id=149434122",	
	}
	--script.Sound.SoundId = Songs[math.random(1,#Songs)]
	
	function TweenFieldOfView(Amount,Bool)
		if Bool then
			for i = 1,Amount do
				Camera.FieldOfView = Camera.FieldOfView + math.random(1,2)
		--		RunService.RenderStepped:wait()
				local rando = math.random(1,60)
				if rando == 60 then
					local old = Camera.FieldOfView
					Camera.FieldOfView = 10	
						game.Lighting.FogColor = Color3.new(math.random(1000160,340000160)/255, math.random(1000160,340000160)/255, math.random(1000160,340000160)/255)
			game.Lighting.ColorShift_Bottom = Color3.new(math.random(0,270000160)/255, math.random(0,270000160)/255, math.random(0,270000160)/255)
		game.Lighting.ColorShift_Top = Color3.new(math.random(0,270000160)/255, math.random(0,270000160)/255, math.random(0,270000160)/255)
		game.Lighting.OutdoorAmbient = Color3.new(math.random(0,270000160)/255, math.random(0,270000160)/255, math.random(0,270000160)/255)
					wait()
					Camera.FieldOfView = old
				elseif rando &lt;= 3 then
					local old = Camera.FieldOfView
					Camera.FieldOfView = Camera.FieldOfView + 30
					wait()
					Camera.FieldOfView = old
				end
				wait()
			end -- 90
		else
			for i = 1,Amount do
				Camera.FieldOfView = Camera.FieldOfView - math.random(1,2)
		--		RunService.RenderStepped:wait()
				local rando = math.random(1,20)
				wait()
			end -- 90	
		end
	end
	
	script.Sound:Play()
	
	spawn(function()
		while active do	
			local rando = math.random(-2,2)
			if script.Sound.Pitch &lt; 0.2 then
				rando = rando + 2
			elseif script.Sound.Pitch &gt; 2 then
				rando = rando - 1
			elseif script.Sound.Pitch &gt; 2.6 then
				rando = rando -2
			end
			script.Sound.Pitch = script.Sound.Pitch + rando/50
			wait()	
		end
	end)
	spawn(function()
		while active do
			-- 70 = norm
			TweenFieldOfView(80,true) -- 90
			TweenFieldOfView(60,false) -- 30
			TweenFieldOfView(40,true) -- 70
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(50,true) -- 90
			TweenFieldOfView(100,false)	-- 70
			TweenFieldOfView(40,true) -- 70
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(30,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(30,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
			TweenFieldOfView(5,false) -- 40
			TweenFieldOfView(20,false) -- 30	
			TweenFieldOfView(15,false) -- 30		
		end
	end)
	
	spawn(function()
	
		
		game.Lighting.Ambient = Color3.new(0,0,0)
		game.Lighting.Brightness = 99
		game.Lighting.ColorShift_Bottom = Color3.new(270000160/255, 280000160/255, 0)
		game.Lighting.ColorShift_Top = Color3.new(270000160/255, 0, 260000160/255)
		game.Lighting.OutdoorAmbient = Color3.new(0, 280000160/255, 260000160/255)
		game.Lighting.FogColor = Color3.new(270000160/255, 280000160/255, 260000160/255)
		game.Lighting.FogEnd = 1e+014
		game.Lighting.FogStart = 0
	
		while active do
			RunService.RenderStepped:wait()
			game.Lighting:SetMinutesAfterMidnight(game.Lighting:GetMinutesAfterMidnight()+2)
		end
	
	end)
	
	local X_angle = 0
	local Y_angle = 0
	local Z_angle = 0
	
	local X = 0
	local Y = 2
	local Z = 10
	
	spawn(function()
		wait(5)
		game.Players.LocalPlayer.Character.Archivable = true
		local model = Instance.new("Model",game.Players.LocalPlayer.Character)
		local index = 4
		while active do
			index = index * 0.93
			for i,v in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
				if v:IsA("BasePart") then
					v.Archivable = true
					local fun = v:Clone()
					fun.Name = "Fun"
					fun.CFrame = v.CFrame
					fun.Parent = model
					fun.CanCollide = true
					fun.Anchored = false
				end
			end
			wait(index)
		end
	end)
	
	spawn(function()
		wait(40)
		active = false
		workspace.CurrentCamera.FieldOfView = 90
	game.Lighting.Ambient = Color3.new(60/255,60/255,60/255)
	game.Lighting.Brightness = 1
	game.Lighting.ColorShift_Bottom = Color3.new(0,0,0)
	game.Lighting.ColorShift_Top = Color3.new(0,0,0)
	game.Lighting.OutdoorAmbient = Color3.new(150/255,150/255,150/255)
	game.Lighting.FogStart = 0
	game.Lighting.FogEnd = 100000
	game.Lighting.FogColor = Color3.new(191/255,191/255,191/255)
	game.Players.LocalPlayer.Character.Humanoid.Health=0
	end)
	
	spawn(function()
		wait(10)
		while active do
			local explode = Instance.new("Explosion",workspace)
			explode.Position = game.Players.LocalPlayer.Character.PrimaryPart.Position + Vector3.new(math.random(-100,100),math.random(-10,40),math.random(-100,100))
			explode.BlastPressure = 0
			wait()
		end
	end)
	
	while active do
	    Camera.CoordinateFrame = CFrame.new(Torso.Position)  --Start at the position of the part
	                           * CFrame.Angles(X_angle, Y_angle, Z_angle) --Rotate by the angle
	                           * CFrame.new(X,Y,Z)       --Move the camera backwards 5 units
	X_angle = X_angle + math.rad(math.random(0,5))    
	Y_angle = Y_angle + math.rad(4)
	Z_angle = Z_angle + math.rad(math.random(0,5))
	local rando = math.random(1,10)
	if rando == 10 then
		old = Z_angle
		Z_angle = Z_angle - math.rad(math.random(10,20))
		wait()
		Z_angle = old
	elseif rando == 1 then
		old = Y_angle
		Y_angle = Y_angle - math.rad(math.random(10,20))
		wait()
		Y_angle = old	
	end
	
	--X = X_angle / 2
		RunService.RenderStepped:wait()
		wait()
	end
end</string>
