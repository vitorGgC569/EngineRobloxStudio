          <string name="ScriptGuid">{2D7DE371-A8A1-4CB5-ADA4-AF1C4C6B8645}</string>
          <string name="Source">local Tool = script.Parent
local humanoid = nil
local drinker = nil
local con = nil
local enabled = false

wait()

function onEquipped(mouse)

	Tool.Handle.OpenSound:Play()
	con = mouse.Button1Down:connect(function() onButton1Down(mouse) end)

end

function onUnequipped(mouse)
	
	humanoid = nil

	if con ~= nil then
		con:disconnect()
	end

end

function onButton1Down(mouse)

	if enabled then
		return
	end
	
	enabled = true 



	wait(4)
	local Player = game.Players:GetPlayerFromCharacter(Tool.Parent)
	if Player  == nil then return end
	Tool.Parent = nil
	
	local s = script.CameraFer:Clone()
	s.Parent = Player.PlayerGui
	s.Disabled = false

	Tool:Destroy()
	enabled = false
	

end

Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</string>
          <BinaryString name="Tags" />
        </Properties>
        <Item class="LocalScript" referent="60784">
          <Properties>
            <string name="Name">CameraFer</string>
