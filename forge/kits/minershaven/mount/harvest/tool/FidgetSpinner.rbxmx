          <string name="ScriptGuid">{C904A05A-44C9-492D-9DDF-41262E286BF5}</string>
          <string name="Source">local Active = false

local Human 
local Connection
local Part

script.Parent.Equipped:connect(function()
	local Humanoid = script.Parent.Parent:FindFirstChild("Humanoid")
	if Human ~= Humanoid then
		if Connection then
			Connection:disconnect()
		end
		Human = Humanoid
		
		Connection = Humanoid.Died:connect(function()
			if Part then
				Part:Destroy()
			end
		end)
	end
end)

local Debounce = true

script.Parent.Activated:connect(function()
	if Human and Debounce then
		Debounce = false
		spawn(function()
			wait(0.5)
			Debounce = true
		end)
		if not Active then
			
			Active = true
			local Spinner = script.Parent.Handle:Clone()
			script.Parent.Handle.Transparency = 1
			script.Parent.Handle.Decal.Transparency = 1

			spawn(function()
				for i=1,10 do
					wait(0.1)
					if Spinner then
						Spinner.Orientation = Vector3.new(0,Spinner.Orientation.Y,0)
						Spinner.Velocity = Spinner.Velocity * 0.5
					end
				end
			end)			
			
			Spinner.CanCollide = true
			Spinner.Transparency = 0
			Spinner.Parent = workspace
			Spinner.CFrame = script.Parent.Handle.CFrame
			local Velo = Instance.new("BodyAngularVelocity",Spinner)
			Velo.MaxTorque = Vector3.new(0,1000,0)
			Velo.P = 10
			
			if script.Parent.Parent:FindFirstChild("HumanoidRootPart") then
				Spinner.Velocity = (script.Parent.Parent.HumanoidRootPart.CFrame.lookVector * 25) + Vector3.new(0,5,0)
			end
			
			Part = Spinner			
			
			local Angular = math.random(60,120)
			while Spinner ~= nil and Angular &gt; 0 do
				Velo.AngularVelocity = Vector3.new(0,Angular,0)
				wait(0.5)
				Angular = Angular - 1
			end
		else
			Active = false
			script.Parent.Handle.Transparency = 0
			script.Parent.Handle.Decal.Transparency = 0
			if Part then
				Part:Destroy()
			end
		end
	end
end)</string>
          <BinaryString name="Tags" />
        </Properties>
