      <Item class="Script" referent="60759">
        <Properties>
          <string name="Name">GravityCoilScript</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{160C42B9-9957-4321-959B-BBDC7670BC9F}</string>
          <string name="Source">local Player
local Tool = script.Parent

function onEquipped()
	script.Parent.Handle.CoilSound:Play()
	Player = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
	if Player then
		Player.Character.Humanoid.JumpPower = Player.Character.Humanoid.JumpPower + 45
		Player.Character.Humanoid.WalkSpeed = Player.Character.Humanoid.WalkSpeed + 4
	end
	Tool.Handle.CoilSound:Play()

end

function onUnequipped()
	if Player then
		Player.Character.Humanoid.JumpPower = Player.Character.Humanoid.JumpPower - 45
		Player.Character.Humanoid.WalkSpeed = Player.Character.Humanoid.WalkSpeed - 4
	end
end


script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)




</string>
          <BinaryString name="Tags" />
