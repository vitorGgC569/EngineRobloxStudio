      <Item class="Script" referent="60843">
        <Properties>
          <string name="Name">Sword</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{762414CA-2552-41AC-AA5A-282ABF4944F6}</string>
          <string name="Source">local Debounce = true
local Swing
local Owner

local Damage = 10

local Equipped = false
local Humanoid

script.Parent.Equipped:connect(function()
	if script.Parent.Handle:FindFirstChild("Equip") then
		script.Parent.Handle.Equip:Play()
	end
	if Swing == nil or Humanoid ~= script.Parent.Parent:FindFirstChild("Humanoid") then
		Humanoid = script.Parent.Parent:FindFirstChild("Humanoid")
		if Humanoid then
			Swing = Humanoid:LoadAnimation(script.Parent.Swing)	
			Owner = game.Players:GetPlayerFromCharacter(Humanoid.Parent)	
		end
	end
	if Humanoid and not Equipped then
		Equipped = true
		Humanoid.WalkSpeed = Humanoid.WalkSpeed + 13
		Humanoid.JumpPower = Humanoid.JumpPower + 8
	end		
end)

script.Parent.Unequipped:connect(function()
	if Equipped and Humanoid then
		Equipped = false
		Humanoid.WalkSpeed = Humanoid.WalkSpeed - 13
		Humanoid.JumpPower = Humanoid.JumpPower - 8
	end
end)

local Pbounce = true

script.Parent.Activated:connect(function()
	if Swing and Pbounce then
		Pbounce = false
		script.Parent.Handle.Slash:Play()
		Swing:Play()
		wait(0.5)
		Pbounce = true
	end
end)




limbs = {"RightFoot","RightLowerLeg","RightUpperLeg","LeftFoot","LeftUpperLeg","LeftLowerLeg"}


script.Parent.Handle.Touched:connect(function(Hit)
	local Human = Hit.Parent:FindFirstChild("Humanoid")
	if Human and Human ~= script.Parent.Parent.Humanoid then
		
		if Human:FindFirstChild("Safe") == nil then
				
			if Hit:FindFirstChild("HitSound") == nil then
				Human:TakeDamage(Damage * (((not Debounce) and 2) or 1))
				
				local Sound = script.Parent.Handle.HitSound:Clone()
				Sound.Parent = Hit
				Sound:Play()
				game.Debris:AddItem(Sound,0.5)
			end
				
			if Human.Health &lt;= 25 then
				local Chance = math.random(1,10)
				if Chance == 7 then
					script.Parent.Handle.Crit:Play()
					for i=1,15 do
						
						local hitPart = Instance.new("Part",workspace)
						hitPart.Transparency = math.random(80,95)/100
						hitPart.TopSurface = Enum.SurfaceType.Smooth
						hitPart.BottomSurface = Enum.SurfaceType.Smooth
						hitPart.BrickColor = BrickColor.new("Hot pink")
						hitPart.Anchored = true
						hitPart.CanCollide = false
						hitPart.Size=Vector3.new(math.random(1,20),math.random(1,20),math.random(1,20))
						hitPart.CFrame = Hit.CFrame + Vector3.new(math.random(-6,6),math.random(-6,6),math.random(-6,6))
						game.Debris:AddItem(hitPart,math.random(12,16))	
													
						hitPart.Touched:connect(function(hitt)
							local Human = hitt.Parent:FindFirstChild("Humanoid")
							if Human then
								local enemyy = game.Players:GetPlayerFromCharacter(hitt.Parent)
								if enemyy == nil or enemyy ~= Owner then
									if Human:FindFirstChild("Safe") == nil then
										Human:TakeDamage(1)
									end
								end
							end
						end)
						
					end
				end
			end
		end
	end
end)</string>
          <BinaryString name="Tags" />
