          <string name="ScriptGuid">{0B0E2F10-6999-4B07-BD60-D7F662AAFFAE}</string>
          <string name="Source">local Automatic = true

	MagSize=100
	FireRate=.02
	Accuracy=.5
	Dammage=15
	ReloadTime=5
	MaxRange=999



local Module = game.ReplicatedStorage:WaitForChild("GunMod")
local GunMod = require(Module)
Module:Clone().Parent = script.Parent

lscript = script

local LaserPart
local Mesh
local creator
local Player = script.Parent

local LastShot = 0

local Tool = lscript.Parent
local Handle = lscript.Parent:WaitForChild("Handle")

local AmmoTag = Instance.new("IntValue")
AmmoTag.Name = "Ammo"
AmmoTag.Parent = Tool

local MaxAmmoTag = Instance.new("IntValue")
MaxAmmoTag.Name = "MaxAmmo"
MaxAmmoTag.Value = MagSize
MaxAmmoTag.Parent = Tool


if Automatic then
	local Tag = Instance.new("BoolValue")
	Tag.Name = "Auto"
	Tag.Parent = Tool
end

lscript.Parent.Equipped:connect(function()
	local EquiPlayer = game.Players:GetPlayerFromCharacter(lscript.Parent.Parent)
	if EquiPlayer ~= Player then
		Player = EquiPlayer
		
		if LaserPart == nil then
			LaserPart=Instance.new("Part")
			LaserPart.Name="Bullet"
			LaserPart.Anchored=true
			LaserPart.CanCollide=false
			LaserPart.Locked=true
			LaserPart.Size=Vector3.new(1, 1, 1)
			LaserPart.TopSurface=0
			LaserPart.BottomSurface=0	
			LaserPart.formFactor=0	
			LaserPart.Material = Enum.Material.Glass
			LaserPart.Transparency = 0.5
			LaserPart.Reflectance = 0.3	
		end
		
		LaserPart.Color = Color3.fromRGB(200,0,0)

		if Mesh == nil then
			Mesh=Instance.new("SpecialMesh", LaserPart)
			Mesh.MeshType="Brick"
			Mesh.Name="Mesh"
			Mesh.Scale=Vector3.new(.2, .2, 1)
		end
		
		if creator == nil then
			creator=Instance.new("ObjectValue")
			creator.Name="creator"
		end
		creator.Value=Player
	end
end)

lscript.Parent.Ammo.Value = MagSize

function Raycast(start,finish,ign) --Returns Part,Position
local AimVector=(finish-start).unit
local HitPart,HitPos=game.Workspace:FindPartOnRay(Ray.new(start,AimVector*MaxRange),ign)
	if HitPart and HitPos then
		if HitPart.Transparency==1 or HitPart.Name=="Bullet" then
			HitPart,HitPos=Raycast(HitPos,AimVector*MaxRange,ign)
		end
	end
return HitPart,HitPos
end

function Damage(Hum)
	return GunMod.Damage(Hum, Dammage, Player)
end

function Fire(aim)
	local RayOrigin = Player.Character.Head.Position
	local PartOrigin=Handle.Position
	local FrDist=(PartOrigin-aim).magnitude
	local spread=Accuracy
	local FinalAim=Vector3.new((aim.x)+(math.random(-(spread/10)*FrDist,(spread/10)*FrDist)),(aim.y)+(math.random(-(spread/10)*FrDist,(spread/10)*FrDist)),(aim.z)+(math.random(-(spread/10)*FrDist,(spread/10)*FrDist)))
	local HitPart,HitPos=Raycast(RayOrigin,FinalAim,Player.Character)
	local BulletLength=(PartOrigin-HitPos).magnitude
	local CFram=CFrame.new(PartOrigin,HitPos)
	local Laser1,Laser2=LaserPart:clone(),LaserPart:clone()
	Laser1.CFrame=CFram*CFrame.new(0,0,-BulletLength*.75)
	Laser1.Mesh.Scale=Vector3.new(Laser1.Mesh.Scale.x,Laser1.Mesh.Scale.y,BulletLength*.5)
	Laser2.CFrame=CFram*CFrame.new(0,0,-BulletLength*.25)
	Laser2.Mesh.Scale=Vector3.new(Laser1.Mesh.Scale.x,Laser1.Mesh.Scale.y,BulletLength*.5)	
	Laser1.Parent=game.Workspace Laser2.Parent=game.Workspace
	game.Debris:AddItem(Laser2,.05)
	game.Debris:AddItem(Laser1,.1)
	if HitPart then
	local Hum=HitPart.Parent:FindFirstChild("Humanoid")
		if not Hum then
			Hum=HitPart.Parent.Parent:FindFirstChild("Humanoid")
		end
		if Hum then
			return Damage(Hum)
		end
	end
	return true
end


function lscript.Func.OnServerInvoke(Player, Action, Info)
	if Action == "Reload" then
		wait(ReloadTime * (1 - lscript.Parent.Ammo.Value/MagSize)) -- Gun reloads faster if you have more ammo
		lscript.Parent.Ammo.Value = MagSize
		return true
	elseif Action == "Fire" then
		if lscript.Parent.Ammo.Value &gt; 0 then
			local Hit = Fire(Info)
			lscript.Parent.Ammo.Value = lscript.Parent.Ammo.Value - 1
			if Hit then
				return Hit
			else
				return true
			end
		else 
			return false
		end
	elseif Action == "Delay" then
		return FireRate
	end
end	

</string>
