          <string name="ScriptGuid">{3F082FB9-D57D-4B6F-B189-460D57CC3400}</string>
          <string name="Source">local Tool = script.Parent
local humanoid = nil
local moonwalk = nil
local playing = false
local connection = nil
local debris = game:GetService("Debris")
local equalizingForce = 236 / 1.2 -- amount of force required to levitate a mass
local gravity = .75 -- things float at &gt; 1
local bodyPos = nil
local sparkles = Instance.new("Sparkles")
sparkles.SparkleColor = Color3.new(0,0.5,0)

function onEquippedLocal(mouse)

	humanoid = Tool.Parent:FindFirstChild("Humanoid")
	moonwalk = humanoid:LoadAnimation(Tool.moonwalk)
	connection = mouse.Button1Down:connect(moonWalker)

end

function onUnequippedLocal()

	humanoid = nil

	if moonwalk ~= nil then
		moonwalk:Stop()
		moonwalk:remove()
		moonwalk = nil
	end

	connection:disconnect()

	if bodyPos ~= nil then
		bodyPos:remove()
	end

	Tool.Handle.DanceMusic:Stop()
	Tool.Handle.DrinkSound:Stop()
	Tool.Handle.WooSound:Stop()

	sparkles:remove()
	sparkles.Parent = nil

end

function moonWalker()

	if playing then
		return
	end

	playing = true

	moonwalk:Play(0.1,1,2)
	Tool.Handle.DrinkSound:Play()

	wait(0.3)
	Tool.Handle.DanceMusic:Play()
	sparkles.Parent = humanoid.Parent:FindFirstChild("Left Leg")

	local HumanoidRootPart = humanoid.Parent:FindFirstChild("HumanoidRootPart")
	local xLook = HumanoidRootPart.CFrame.lookVector.x/(math.abs(HumanoidRootPart.CFrame.lookVector.x) + math.abs(HumanoidRootPart.CFrame.lookVector.z))
	local zLook = HumanoidRootPart.CFrame.lookVector.z/(math.abs(HumanoidRootPart.CFrame.lookVector.x) + math.abs(HumanoidRootPart.CFrame.lookVector.z))
	local unitLook = Vector2.new(xLook,zLook).unit
	local dist = 60

	
	bodyPos = Instance.new("BodyPosition")
	bodyPos.position = Vector3.new(HumanoidRootPart.Position.x + (-unitLook.x * dist), HumanoidRootPart.Position.y + 2,HumanoidRootPart.Position.z + (-unitLook.y * dist))
	print(recursiveGetLift(humanoid.Parent))
	bodyPos.P = recursiveGetLift(humanoid.Parent) * 6.7
	bodyPos.D = bodyPos.P/2
	bodyPos.maxForce = Vector3.new(bodyPos.P,bodyPos.P,bodyPos.P)

	wait(0.9)
	bodyPos.Parent = HumanoidRootPart
	debris:AddItem(bodyPos,5.8)

	wait(6)

	Tool.Handle.WooSound:Play()

	wait(1)

	Tool.Handle.DanceMusic:Stop()
	sparkles.Parent = nil

	playing = false

end

local head = nil
function recursiveGetLift(node)
	local m = 0
	local c = node:GetChildren()
	if (node:FindFirstChild("Head") ~= nil) then head = node:FindFirstChild("Head") end -- nasty hack to detect when your parts get blown off

	for i=1,#c do
		if c[i].className == "Part" then
			if (head ~= nil and (c[i].Position - head.Position).magnitude &lt; 10) then -- GROSS
				if c[i].Name == "Handle" then
					m = m + (c[i]:GetMass() * equalizingForce * 1) -- hack that makes hats weightless, so different hats don't change your jump height
				else
					m = m + (c[i]:GetMass() * equalizingForce * gravity)
				end
			end
		end
		m = m + recursiveGetLift(c[i])
	end
	return m
end


Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
</string>
