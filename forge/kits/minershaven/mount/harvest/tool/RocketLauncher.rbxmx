          <string name="ScriptGuid">{0853A50B-86DA-4D46-B878-EB1C13EB6A95}</string>
          <string name="Source">local Mouse

script.Parent.Equipped:connect(function(Moose)
	Mouse = Moose
end)

local Debounce = true

script.Parent.Activated:connect(function()
	if Mouse and Debounce then
		Debounce = false
		script.Parent.Launch:InvokeServer(Mouse.Hit.p)
		Debounce = true
	end
end)</string>
