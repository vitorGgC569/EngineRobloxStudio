          <string name="ScriptGuid">{E061AAC4-07E0-4D42-8B9E-A1E10BE0339F}</string>
          <string name="Source">local Debounce = true

local Rocket
local TargetPart

local function Boom()
	if TargetPart and Rocket then
		TargetPart.CFrame = Rocket.CFrame
		
		local Explode = Instance.new("Explosion")
		Explode.Position = Rocket.Position
		Explode.DestroyJointRadiusPercent = 0
		Explode.BlastPressure = 500000

		
		Explode.BlastRadius = math.floor(Explode.BlastRadius * 1.5)
		
		local ExplodeSound = script.Explode:Clone()
		ExplodeSound.Parent = TargetPart
		ExplodeSound:Play()
		
		Explode.Parent = workspace
		
		Explode.Hit:connect(function(Part,Distance)
			if Part.Name == "HumanoidRootPart" then
				local Human = Part.Parent:FindFirstChild("Humanoid")
				if Human and Human:FindFirstChild("Safe") == nil then
					Human:TakeDamage(100)
					Human.Sit = true
				end
			end
		end)
		
		Rocket:Destroy()
		Rocket = nil
		
		wait(1)
		TargetPart:Destroy()
		
		Debounce = true	
	end		
end

function Fire(Player, Position)
	if Rocket ~= nil and Rocket.Parent == workspace then
		Boom()
	elseif Debounce and Rocket == nil then
		
		Debounce = false
		
		script.Parent.Handle.Fire:Play()
		
		Rocket = Instance.new("Part",workspace)
		Rocket.Size = Vector3.new(1,1,1)
		local Mesh = script.Mesh:Clone()
		Mesh.Parent = Rocket
		local Fire = Instance.new("Fire",Rocket)
		Fire.Size = 1
		
		Rocket.CFrame = CFrame.new(script.Parent.Handle.Position + script.Parent.Handle.CFrame.lookVector * 3)
		
		

		
		TargetPart = Instance.new("Part",workspace)
		TargetPart.Size = Vector3.new(0.5,0.5,0.5)
		TargetPart.Transparency = 1
		TargetPart.CanCollide = false
		TargetPart.Anchored = true
		TargetPart.CFrame = CFrame.new(Position)
		TargetPart.Name = "RocketTarget"
		
		local Force = Instance.new("RocketPropulsion",Rocket)
		Force.Target = TargetPart
		Force.CartoonFactor = 1
		Force.TurnP = 99999
		Force.MaxSpeed = 45
		Force.MaxThrust = 4000


		wait()		
		
		Force:Fire()
		
		local Sound = script.Rocket:Clone()
		Sound.Parent = Rocket
		Sound:Play()
		

		
		Force.ReachedTarget:connect(Boom)
	end
end

script.Parent.Launch.OnServerInvoke = Fire</string>
