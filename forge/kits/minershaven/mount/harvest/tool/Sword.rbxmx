      <Item class="Script" referent="60906">
        <Properties>
          <string name="Name">Sword</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{B87E440F-FFA6-48C4-A3E9-6455A851568D}</string>
          <string name="Source">local Debounce = true
local Swing
local Humanoid

local Damage = 4

script.Parent.Equipped:connect(function(Mouse)
	if script.Parent.Handle:FindFirstChild("Equip") then
		script.Parent.Handle.Equip:Play()
	end
	if Swing == nil or Humanoid ~= script.Parent.Parent:FindFirstChild("Humanoid") then
		Humanoid = script.Parent.Parent:FindFirstChild("Humanoid")
		if Humanoid then
			Swing = Humanoid:LoadAnimation(script.Parent.Swing)		
		end
	end
end)
script.Parent.Activated:connect(function()
	if Swing and Debounce then
		Debounce = false
		script.Parent.Handle.Slash:Play()
		Swing:Play()
		wait(0.5)
		Debounce = true
	end
end)

limbs = {"RightFoot","RightLowerLeg","RightUpperLeg","LeftFoot","LeftUpperLeg","LeftLowerLeg"}


local Debounce = true
script.Parent.Handle.Touched:connect(function(Hit)
	if Debounce then
		local Human = Hit.Parent:FindFirstChild("Humanoid")
		if Human and Human ~= script.Parent.Parent.Humanoid then
			Debounce = false
			if Human:FindFirstChild("Safe") == nil then
				Human:TakeDamage(Damage * (((not Debounce) and 2) or 1))
				Human.Sit = true
				local Chance = math.random(1,13)
				if Chance == 7 then
					local limb = limbs[math.random(1,#limbs)]
					local ouch = Human.Parent:FindFirstChild(limb)
					if ouch then
						ouch:Destroy()
						script.Parent.Handle.Crit:Play()
						Human.WalkSpeed = Human.WalkSpeed * 0.7
						Human.JumpPower = Human.JumpPower - 0.7
					end
				end
			end
			local Sound = script.Parent.Handle.HitSound:Clone()
			Sound.Parent = Hit
			Sound:Play()
			game.Debris:AddItem(Sound,1)
		end
		wait(0.2)
		Debounce = true
	end
end)</string>
          <BinaryString name="Tags" />
