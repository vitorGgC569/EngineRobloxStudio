      <Item class="Script" referent="60881">
        <Properties>
          <string name="Name">Sword</string>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null>
            </null>
          </Content>
          <string name="ScriptGuid">{629E4ABA-504C-42A2-AFD8-6957CE2F347A}</string>
          <string name="Source">local Swing
local Owner

local Damage = 6

local Equipped = false
local Humanoid

script.Parent.Equipped:connect(function()
	if script.Parent.Handle:FindFirstChild("Equip") then
		script.Parent.Handle.Equip:Play()
	end

	if Swing == nil or Humanoid ~= script.Parent.Parent:FindFirstChild("Humanoid") then
		Humanoid = script.Parent.Parent:FindFirstChild("Humanoid")
		if Humanoid then
			Swing = Humanoid:LoadAnimation(script.Parent.Swing)	
			Owner = game.Players:GetPlayerFromCharacter(Humanoid.Parent)	
		end
	end
	
	if Humanoid and not Equipped then
		Equipped = true
		Humanoid.WalkSpeed = Humanoid.WalkSpeed + 7
	end		
end)

script.Parent.Unequipped:connect(function()
	if Equipped and Humanoid then
		Equipped = false
		Humanoid.WalkSpeed = Humanoid.WalkSpeed - 7
	end
end)

local Pbounce = true

script.Parent.Activated:connect(function()
	if Swing and Pbounce then
		Pbounce = false
		script.Parent.Handle.Slash:Play()
		Swing:Play()
		wait(0.5)
		Pbounce = true
	end
end)


local Debounce = true
script.Parent.Handle.Touched:connect(function(Hit)
	if Debounce then
		local Human = Hit.Parent:FindFirstChild("Humanoid")
		if Human and Human ~= script.Parent.Parent.Humanoid then
			Debounce = false
			if Human:FindFirstChild("Safe") == nil then
				Human:TakeDamage(Damage * (((not Debounce) and 2) or 1))
				Human.Sit = true
				local Chance = math.random(1,10)
				if Chance == 7 then
					local bodyparts = {}
					for i,part in pairs(Human.Parent:GetChildren()) do
						if part:IsA("BasePart") then
							table.insert(bodyparts,part)
						end
					end
					for i=1,5 do
						local part = bodyparts[math.random(1,#bodyparts)]
						local sickcolors = {BrickColor.new("Grime"),BrickColor.new("Bright green"),BrickColor.new("Artichoke")}
						part.BrickColor = sickcolors[math.random(1,#sickcolors)]
					end
					if Human.Parent:FindFirstChild("Head") and Human.Parent.Head:FindFirstChild("face") then
						Human.Parent.Head.face.Texture = "http://www.roblox.com/asset/?id=199883788"
					end
					if Human.Parent:FindFirstChild("Head") and Human.Parent.Head:FindFirstChild("Decal") then
						Human.Parent.Head.Decal.Texture = "http://www.roblox.com/asset/?id=199883788"
					end					
					local Sound = script.Parent.Handle.Crit:Clone()
					Sound.Parent = Hit
					Sound:Play()
					game.Debris:AddItem(Sound,10)
				end
			end
			local Sound = script.Parent.Handle.HitSound:Clone()
			Sound.Parent = Hit
			Sound:Play()
			game.Debris:AddItem(Sound,1)
		end
		wait()
		Debounce = true
	end
end)</string>
