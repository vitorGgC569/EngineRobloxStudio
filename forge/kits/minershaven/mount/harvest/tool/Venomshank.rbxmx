          <string name="Source">script.Parent.Equipped:connect(function()
	workspace.CurrentCamera.FieldOfView = workspace.CurrentCamera.FieldOfView + 7
end)
script.Parent.Unequipped:connect(function()
	workspace.CurrentCamera.FieldOfView = workspace.CurrentCamera.FieldOfView - 7
end)</string>
