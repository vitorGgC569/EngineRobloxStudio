          <string name="ScriptGuid">{3e080eb7-0149-4c8d-805a-a13f0fde238c}</string>
          <string name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Otter = require(ReplicatedStorage.Otter)
local OtterApp = script.Parent

-- animated square
local redSquare = OtterApp:FindFirstChild("redSquare", true)
local redSquarePosition = OtterApp:FindFirstChild("redSquarePosition", true)

-- animated background
local animateFrameBackground = OtterApp:FindFirstChild("_1_animateBackgroundColor", true)
local backgroundColor = OtterApp:FindFirstChild("backgroundColor", true)

-- spring parameters
local checkbox = OtterApp:FindFirstChild("Checkbox", true)
local CHECKED = "[X]"
local UNCHECKED = "[  ]"
checkbox.Text = UNCHECKED

local settingGroup1 = OtterApp:FindFirstChild("SettingGroup1", true)
local settingGroup2 = OtterApp:FindFirstChild("SettingGroup2", true)
settingGroup1.Visible = true
settingGroup2.Visible = not settingGroup1.Visible

local dampingRatioValue = OtterApp:FindFirstChild("DampingRatioValue", true)
local frequencyValue = OtterApp:FindFirstChild("FrequencyValue", true)
local restingVeclocityLimitValue = OtterApp:FindFirstChild("RestingVeclocityLimitValue", true)
local restingPositionLimitValue = OtterApp:FindFirstChild("RestingPositionLimitValue", true)

local stiffnessValue = OtterApp:FindFirstChild("StiffnessValue", true)
local dampingValue = OtterApp:FindFirstChild("DampingValue", true)
local massValue = OtterApp:FindFirstChild("MassValue", true)

-- replay 
local replayDuration = OtterApp:FindFirstChild("ReplayDuration", true)
replayDuration.Text = ""
local replayStartTime = tick()
local replayInProgress = false


-- motor
local currentMotorValue = OtterApp:FindFirstChild("currentMotorValue", true)
currentMotorValue.Text = ""
local motor = Otter.createSingleMotor(0)

motor:onStep(function(newValue)
	-- motor value
	currentMotorValue.Text = ("motor value: %6.2f"):format(newValue)
	currentMotorValue.TextColor3 = Color3.fromRGB(20, 120, 20)

	-- position
	local xOffset = 0
	local yOffset = 0
	local yScale = 0.5 
	
	local newPosition = UDim2.new(newValue, xOffset, yScale, yOffset)
	redSquare.Position = newPosition
	local newPositionAsText = ("Position: (%6.2f, %6.2f, %6.2f, %6.2f)"):format(
		newValue, xOffset, yScale, yOffset)
	redSquarePosition.Text = newPositionAsText
	
	-- color
	local maxColor = 200
	local maxColorNormalized = maxColor/255
	
	local newColor = maxColorNormalized * newValue
	animateFrameBackground.BackgroundColor3 = Color3.new(newColor, newColor, newColor)
	-- display values that match the values shown in the studio editor
	local newColor_0_255 = newValue * maxColor
	local newColorAsText = ("Color: (%6.2f, %6.2f, %6.2f)"):format(
		newColor_0_255, newColor_0_255, newColor_0_255)
	backgroundColor.Text = newColorAsText
--	print(("value: %6.5f %s %s (%5.2f, %5.2f)"):format(
--		newValue, newPositionAsText, newColorAsText, 
--		tonumber(frequencyValue.Text), tonumber(dampingRatioValue.Text)))
end)

motor:onComplete(function()
	currentMotorValue.TextColor3 = Color3.fromRGB(78, 78, 78)

	if replayInProgress then
		local endTime = tick()
		local duration = endTime - replayStartTime	
		replayDuration.Text = ("duration: %4.3f s"):format(duration)
		replayInProgress = false
	end
end)

-- helper motor functions  
local function setSpringGoalTo1()
	local springParameters
	if checkbox.Text == CHECKED then
		if stiffnessValue.Text == "" or dampingValue.Text == "" or massValue.Text == "" then
			warn("Please set all parameters.")
			return
		end
		springParameters = {
			stiffness = tonumber(stiffnessValue.Text),
			damping = tonumber(dampingValue.Text),
			mass = tonumber(massValue.Text),
		}
	else
		springParameters = {
			frequency = tonumber(frequencyValue.Text),
			dampingRatio = tonumber(dampingRatioValue.Text),
		}
	end
	
	springParameters.restingVelocityLimit = tonumber(restingVeclocityLimitValue.Text)
	springParameters.restingPositionLimit = tonumber(restingPositionLimitValue.Text)
	
	motor:setGoal(Otter.spring(1, springParameters))	
end

local function resetMotorTo0()
	motor:setGoal(Otter.instant(0))
	motor:step(0)
	setSpringGoalTo1()
	motor:stop()
end

local function setupReplay0_1AndReplay(replay)
	resetMotorTo0()
	if replay then
		replayInProgress = true
		replayDuration.Text = ""
		replayStartTime = tick()
		motor:start()
	end
end

-- set initial motor state
resetMotorTo0()


--  text box functions used to format input spring paramters 
checkbox.MouseButton1Click:Connect(function()
	if settingGroup1.Visible then
		checkbox.Text = CHECKED
		settingGroup1.Visible = false
		settingGroup2.Visible = true
	else
		checkbox.Text = UNCHECKED
		settingGroup1.Visible = true
		settingGroup2.Visible = false
	end
end)


local function convertToNumber(userEnteredText)
	local digitsAndPeriodsOnly = string.gsub(userEnteredText, "[^%d%.]", "")
	local number = string.match(digitsAndPeriodsOnly, "%d+.?%d*") or ""
	return number
end

dampingRatioValue.FocusLost:Connect(setupReplay0_1AndReplay)
dampingRatioValue:GetPropertyChangedSignal("Text"):Connect(function()
	dampingRatioValue.Text = convertToNumber(dampingRatioValue.Text) 
end)

frequencyValue.FocusLost:Connect(setupReplay0_1AndReplay)
frequencyValue:GetPropertyChangedSignal("Text"):Connect(function()
	frequencyValue.Text = convertToNumber(frequencyValue.Text) 
end)

stiffnessValue.FocusLost:Connect(setupReplay0_1AndReplay)
stiffnessValue:GetPropertyChangedSignal("Text"):Connect(function()
	stiffnessValue.Text = convertToNumber(stiffnessValue.Text) 
end)

dampingValue.FocusLost:Connect(setupReplay0_1AndReplay)
dampingValue:GetPropertyChangedSignal("Text"):Connect(function()
	dampingValue.Text = convertToNumber(dampingValue.Text) 
end)

massValue.FocusLost:Connect(setupReplay0_1AndReplay)
massValue:GetPropertyChangedSignal("Text"):Connect(function()
	massValue.Text = convertToNumber(massValue.Text) 
end)

restingVeclocityLimitValue.FocusLost:Connect(setupReplay0_1AndReplay)
restingVeclocityLimitValue:GetPropertyChangedSignal("Text"):Connect(function()
	restingVeclocityLimitValue.Text = convertToNumber(restingVeclocityLimitValue.Text) 
end)

restingPositionLimitValue.FocusLost:Connect(setupReplay0_1AndReplay)
frequencyValue:GetPropertyChangedSignal("Text"):Connect(function()
	restingPositionLimitValue.Text = convertToNumber(restingPositionLimitValue.Text) 
end)

-- Buttons
local function findButtonAndSetOnActivated(buttonName, activatedCallback)
	local button = OtterApp:FindFirstChild(buttonName, true)
	if button then
		local fullName = button:GetFullName()
		button.Activated:Connect(activatedCallback)
	else
		print("INVALID NAME", buttonName)
	end
end

findButtonAndSetOnActivated("StopButton", function()
	print("Stop")
	motor:stop()
end)

findButtonAndSetOnActivated("StepButton", function()
	print("Step by 0.05")
	replayDuration.Text = ""
	motor:step(0.05)
end)

findButtonAndSetOnActivated("StartButton", function()
	print("Start spring animation to 1")
	setSpringGoalTo1()
end)

findButtonAndSetOnActivated("ResetButton", function()
	resetMotorTo0()
end)

findButtonAndSetOnActivated("ReplayButton", function()
	setupReplay0_1AndReplay(true)
end)



</string>
