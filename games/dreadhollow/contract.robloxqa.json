{
  "$schema": "../../schemas/game-contract.schema.json",
  "schemaVersion": 1,
  "contractId": "dreadhollow.contract",
  "game": {
    "name": "Dreadhollow",
    "genre": "survival",
    "max_players": 6,
    "target_devices": ["desktop"]
  },
  "performance_budget": {
    "client": {"target_fps": 55, "max_frame_ms": 18.2},
    "instances": {"max_workspace": 4000},
    "mobile": {"mandatory": false}
  },
  "visualQuality": {
    "spec": "contracts/visual-quality.json",
    "specId": "dreadhollow.visual-quality",
    "schemaMajor": 1,
    "required": true,
    "release": {
      "minimumScore": 80,
      "minimumRuleCoverage": 0.6,
      "minimumValidationLevel": "VISUALLY_VALIDATED",
      "missingEvidence": "FAIL"
    }
  },
  "release_gate": {
    "required_categories": ["structural", "gameplay", "runtime"],
    "forbidden_sources": ["headless-runtime"],
    "minimum_requirement_coverage": 1.0,
    "minimum_category_coverage": {
      "structural": 1.0,
      "gameplay": 1.0,
      "runtime": 1.0
    },
    "minimum_validation_by_type": {
      "structural": "STATICALLY_VALIDATED",
      "gameplay": "RUNTIME_VALIDATED",
      "runtime": "RUNTIME_VALIDATED"
    },
    "maximum_evidence_age_seconds_by_level": {
      "STATICALLY_VALIDATED": 604800,
      "RUNTIME_VALIDATED": 86400,
      "VISUALLY_VALIDATED": 86400,
      "E2E_VALIDATED": 86400
    },
    "minimum_visual_score": 80,
    "require_trustworthy_captures": true
  },
  "requirements": [
    {"id": "required_project_topology_exists", "probe": "structural_integrity", "type": "structural", "severity": "critical", "validation": {"minimum_level": "STATICALLY_VALIDATED", "allowed_sources": ["filesystem"]}},
    {"id": "release_contract_is_valid", "probe": "contract_schema", "type": "structural", "severity": "critical", "validation": {"minimum_level": "STATICALLY_VALIDATED", "allowed_sources": ["contract-validator"]}},
    {"id": "player_can_spawn", "probe": "spawn_clearance", "type": "gameplay", "severity": "critical", "validation": {"minimum_level": "RUNTIME_VALIDATED"}},
    {"id": "pages_are_reachable", "probe": "objective_reachable", "type": "gameplay", "severity": "critical", "validation": {"minimum_level": "RUNTIME_VALIDATED"}},
    {"id": "gate_requires_six_pages", "probe": "button_interaction", "type": "gameplay", "severity": "critical", "validation": {"minimum_level": "RUNTIME_VALIDATED"}},
    {"id": "flashlight_chapel_loop", "probe": "button_interaction", "type": "gameplay", "severity": "major", "validation": {"minimum_level": "RUNTIME_VALIDATED"}},
    {"id": "hollow_hunts_by_sight", "probe": "button_interaction", "type": "gameplay", "severity": "major", "validation": {"minimum_level": "RUNTIME_VALIDATED"}},
    {"id": "death_keeps_pages", "probe": "spawn_clearance", "type": "gameplay", "severity": "major", "validation": {"minimum_level": "RUNTIME_VALIDATED"}},
    {"id": "runtime_has_no_errors", "probe": "runtime_error", "type": "runtime", "severity": "critical", "validation": {"minimum_level": "RUNTIME_VALIDATED"}}
  ]
}
