{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/asset-manifest.schema.json",
  "title": "RQE Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "assets", "integrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "integrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/integration" }
    }
  },
  "$defs": {
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "mediaType", "label"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "termsUrl", "usageScope", "verified"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "termsUrl": { "type": "string", "minLength": 1 },
        "usageScope": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "commercialUse": { "type": "boolean" },
        "attributionRequired": { "type": "boolean" },
        "attribution": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourceUri", "retrievedAt"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "sourceUri": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "minLength": 1 },
        "sourceAssetId": { "type": "string", "minLength": 1 },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operationId": { "type": "string" },
        "tool": { "type": "string" },
        "prompt": { "type": "string" }
      },
      "anyOf": [
        { "required": ["sourceAssetId"] },
        { "required": ["contentSha256"] }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "displayName", "description", "state", "provider",
        "requirement", "previews", "metadata"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["mesh", "audio", "animation", "icon"] },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["draft", "validated", "uploading", "published", "approved", "rejected", "unavailable"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "requirement": { "enum": ["production-required", "optional", "development"] },
        "previews": { "type": "array", "items": { "$ref": "#/$defs/preview" } },
        "license": { "$ref": "#/$defs/license" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "localPath": { "type": "string" },
        "contentType": { "type": "string" },
        "remoteAssetId": { "type": "string", "minLength": 1 },
        "moderationState": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "requirement": { "const": "production-required" } },
            "required": ["requirement"]
          },
          "then": {
            "properties": {
              "state": { "const": "approved" },
              "moderationState": { "enum": ["APPROVED", "MODERATION_STATE_APPROVED"] },
              "previews": { "minItems": 1 },
              "license": {
                "properties": {
                  "verified": { "const": true },
                  "evidence": { "type": "string", "minLength": 1 }
                },
                "required": ["evidence"]
              }
            },
            "required": ["remoteAssetId", "moderationState", "license", "provenance"]
          }
        }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "target", "property"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "expectedClass": { "type": "string", "minLength": 1 }
      }
    }
  }
}
