{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/asset-work-request.v1.schema.json",
  "title": "RQE Asset Work Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "provider", "asset", "creator", "integrations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider": {"const": "roblox-open-cloud"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "displayName", "description", "path", "source", "requirement", "previews", "metadata"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["mesh", "audio", "animation", "icon"]},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "path": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["production-required", "optional", "development"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "uri"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "uri": {"type": "string", "minLength": 1},
            "retrievedAt": {"type": "string", "minLength": 1},
            "creatorId": {"type": "string", "minLength": 1},
            "tool": {"type": "string", "minLength": 1},
            "prompt": {"type": "string", "minLength": 1}
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "termsUrl", "usageScope", "verified"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "termsUrl": {"type": "string", "minLength": 1},
            "usageScope": {"type": "string", "minLength": 1},
            "verified": {"type": "boolean"},
            "commercialUse": {"type": "boolean"},
            "attributionRequired": {"type": "boolean"},
            "attribution": {"type": "string"},
            "evidence": {"type": "string", "minLength": 1}
          }
        },
        "previews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "mediaType"],
            "properties": {
              "uri": {"type": "string", "minLength": 1},
              "mediaType": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "metadata": {"type": "object"}
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "groupId": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "property"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "property": {"type": "string", "minLength": 1},
          "expectedClass": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
