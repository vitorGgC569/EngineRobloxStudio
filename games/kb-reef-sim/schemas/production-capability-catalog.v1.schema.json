{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rqe://schemas/production-capability-catalog.v1.schema.json",
  "title": "RQE industrial Roblox production capability catalog v1",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "catalogId",
    "commandManifest",
    "phases",
    "capabilities"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "commandManifest": {
      "type": "object",
      "required": ["path", "schemaVersion", "protocol", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "schemaVersion": {"type": "integer", "minimum": 1},
        "protocol": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "title",
          "description",
          "status",
          "validationLevel",
          "bridgeCommands",
          "adapters",
          "risks",
          "limitations",
          "gaps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "phase": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["AVAILABLE", "PARTIAL", "BLOCKED", "GAP", "UNSUPPORTED"]
          },
          "validationLevel": {
            "enum": [
              "NOT_VALIDATED",
              "STATICALLY_VALIDATED",
              "RUNTIME_VALIDATED",
              "VISUALLY_VALIDATED",
              "E2E_VALIDATED"
            ]
          },
          "bridgeCommands": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["method", "required"],
              "properties": {
                "method": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                },
                "required": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "adapters": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["symbol", "role", "required"],
              "properties": {
                "symbol": {
                  "type": "string",
                  "pattern": "^rqe(?:\\.[a-z_][a-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
                },
                "role": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "risks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "gaps": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
