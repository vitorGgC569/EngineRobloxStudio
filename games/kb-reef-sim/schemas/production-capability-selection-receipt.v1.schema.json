{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rqe://schemas/production-capability-selection-receipt.v1.schema.json",
  "title": "RQE production capability selection receipt v1",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "receiptType",
    "receiptId",
    "createdAt",
    "authorizesRelease",
    "receiptValidationLevel",
    "selectionStatus",
    "catalog",
    "commandManifest",
    "request",
    "selectedCapabilities",
    "coverage",
    "blockers"
  ],
  "properties": {
    "$schema": {"const": "rqe://schemas/production-capability-selection-receipt.v1.schema.json"},
    "schemaVersion": {"const": 1},
    "receiptType": {"const": "rqe.production-capability-selection"},
    "receiptId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "createdAt": {"type": "string", "minLength": 1},
    "authorizesRelease": {"const": false},
    "receiptValidationLevel": {"const": "STATICALLY_VALIDATED"},
    "selectionStatus": {"enum": ["PASS", "BLOCKED"]},
    "catalog": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "commandManifest": {
      "type": "object",
      "required": ["sha256", "schemaVersion", "protocol"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schemaVersion": {"type": "integer", "minimum": 1},
        "protocol": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["selectorMode", "phases", "capabilityIds", "minimumValidationLevel"],
      "properties": {
        "selectorMode": {"const": "UNION"},
        "phases": {"$ref": "#/$defs/strings"},
        "capabilityIds": {"$ref": "#/$defs/strings"},
        "minimumValidationLevel": {
          "enum": ["NOT_VALIDATED", "STATICALLY_VALIDATED", "RUNTIME_VALIDATED", "VISUALLY_VALIDATED", "E2E_VALIDATED"]
        }
      },
      "additionalProperties": false
    },
    "selectedCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "phase", "status", "declaredValidationLevel", "selectable", "reasons", "bridgeCommands", "adapters", "risks", "limitations", "gaps"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "declaredValidationLevel": {"type": "string", "minLength": 1},
          "selectable": {"type": "boolean"},
          "reasons": {"$ref": "#/$defs/strings"},
          "bridgeCommands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method", "required", "availability"],
              "properties": {
                "method": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "availability": {"enum": ["supported", "unsupported"]}
              },
              "additionalProperties": false
            }
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["symbol", "required", "resolved"],
              "properties": {
                "symbol": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "resolved": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "risks": {"$ref": "#/$defs/strings"},
          "limitations": {"$ref": "#/$defs/strings"},
          "gaps": {"$ref": "#/$defs/strings"}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["selectedCapabilityTotal", "readyCapabilityTotal", "readyCapabilityCoverage", "requiredBridgeCommandTotal", "supportedRequiredBridgeCommandTotal", "requiredBridgeCommandCoverage", "requiredAdapterTotal", "resolvedRequiredAdapterTotal", "requiredAdapterCoverage"],
      "properties": {
        "selectedCapabilityTotal": {"type": "integer", "minimum": 1},
        "readyCapabilityTotal": {"type": "integer", "minimum": 0},
        "readyCapabilityCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "requiredBridgeCommandTotal": {"type": "integer", "minimum": 0},
        "supportedRequiredBridgeCommandTotal": {"type": "integer", "minimum": 0},
        "requiredBridgeCommandCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "requiredAdapterTotal": {"type": "integer", "minimum": 0},
        "resolvedRequiredAdapterTotal": {"type": "integer", "minimum": 0},
        "requiredAdapterCoverage": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "capabilityId", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "capabilityId": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
