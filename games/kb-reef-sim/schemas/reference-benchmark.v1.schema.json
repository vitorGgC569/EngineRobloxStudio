{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/reference-benchmark.v1.schema.json",
  "title": "RQE Independent Reference Benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "benchmarkId", "revision", "productId",
    "createdAt", "frozenAt", "candidateDerived", "independenceReceipt",
    "sources", "observations"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "benchmarkId": {"$ref": "#/$defs/qualifiedId"},
    "revision": {"type": "integer", "minimum": 1},
    "productId": {"$ref": "#/$defs/qualifiedId"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "frozenAt": {"$ref": "#/$defs/timestamp"},
    "candidateDerived": {"const": false},
    "independenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision", "basis", "verifiedBy", "verifiedAt",
        "excludedCandidateProductId", "candidateArtifactsUsed"
      ],
      "properties": {
        "decision": {"const": "INDEPENDENT"},
        "basis": {
          "enum": ["external-published-product", "director-owned-reference", "licensed-reference-set"]
        },
        "verifiedBy": {"type": "string", "minLength": 1, "maxLength": 200},
        "verifiedAt": {"$ref": "#/$defs/timestamp"},
        "excludedCandidateProductId": {"$ref": "#/$defs/qualifiedId"},
        "candidateArtifactsUsed": {"const": false}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "observations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "qualifiedId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "referenceProductId", "label", "sourceType", "originLocator",
        "acquiredAt", "snapshotPath", "sha256", "candidateDerived", "rights"
      ],
      "properties": {
        "sourceId": {"$ref": "#/$defs/id"},
        "referenceProductId": {"$ref": "#/$defs/qualifiedId"},
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "sourceType": {
          "enum": ["screenshot", "video-frame", "web-page", "design-document", "gameplay-capture", "asset"]
        },
        "originLocator": {"type": "string", "minLength": 1, "maxLength": 2000},
        "acquiredAt": {"$ref": "#/$defs/timestamp"},
        "snapshotPath": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "candidateDerived": {"const": false},
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "usageScope"],
          "properties": {
            "status": {"enum": ["licensed", "owned", "public-domain", "fair-use-analysis"]},
            "usageScope": {"const": "benchmark-only"}
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId", "metricId", "scope", "value", "unit", "method",
        "tool", "observedAt", "sourceIds", "confidence", "candidateDerived"
      ],
      "properties": {
        "observationId": {"$ref": "#/$defs/id"},
        "metricId": {"$ref": "#/$defs/qualifiedId"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 500},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 100},
        "method": {"type": "string", "minLength": 1, "maxLength": 1000},
        "tool": {"type": "string", "minLength": 1, "maxLength": 200},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "sourceIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "confidence": {"$ref": "#/$defs/fraction"},
        "candidateDerived": {"const": false}
      }
    }
  }
}
