{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/scenario-result-receipt.v1.schema.json",
  "title": "RQE hash-bound scenario result receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "producerId", "scenarioId", "stateId", "runId",
    "buildHash", "placeHash", "place", "sessionId", "source", "observedAt",
    "validationLevel", "coverage", "conclusive", "status", "outcome",
    "scenarioSpec", "declaredSteps", "executedSteps", "issues", "result"
  ],
  "properties": {
    "$schema": {"const": "https://rqe.local/schemas/scenario-result-receipt.v1.schema.json"},
    "schemaVersion": {"const": 1},
    "producerId": {"const": "scenario.runner"},
    "scenarioId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "stateId": {"type": ["string", "null"]},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "buildHash": {"$ref": "#/$defs/hash"},
    "placeHash": {"$ref": "#/$defs/hash"},
    "place": {"type": "string"},
    "sessionId": {"type": "string"},
    "source": {"const": "studio-scenario"},
    "observedAt": {"type": "string", "minLength": 1},
    "validationLevel": {
      "enum": [
        "NOT_VALIDATED", "STATICALLY_VALIDATED", "RUNTIME_VALIDATED",
        "VISUALLY_VALIDATED", "E2E_VALIDATED"
      ]
    },
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "conclusive": {"type": "boolean"},
    "status": {"enum": ["COMPLETE", "BLOCKED"]},
    "outcome": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "scenarioSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "declaredSteps": {"type": "integer", "minimum": 0},
    "executedSteps": {"type": "integer", "minimum": 0},
    "issues": {"type": "array", "items": {"type": "string"}},
    "result": {"type": ["object", "null"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
