{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/visual-review-attempt.v1.schema.json",
  "title": "RQE Visual Review Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "operation",
    "provider",
    "status",
    "validationLevel",
    "reasonCode",
    "reason",
    "authorizesRelease",
    "runId",
    "buildHash",
    "placeHash",
    "specHash",
    "captureManifestSha256",
    "model",
    "createdAt"
  ],
  "properties": {
    "$schema": {"const": "rqe://schemas/visual-review-attempt.v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "rqe.visual.review"},
    "provider": {"const": "openai-responses"},
    "status": {"enum": ["BLOCKED", "INCONCLUSIVE"]},
    "validationLevel": {"const": "NOT_VALIDATED"},
    "reasonCode": {"type": "string", "pattern": "^OPENAI_[A-Z0-9_]+$"},
    "reason": {"type": "string", "minLength": 1},
    "authorizesRelease": {"const": false},
    "runId": {"type": "string", "minLength": 1},
    "buildHash": {"$ref": "#/$defs/sha256"},
    "placeHash": {"$ref": "#/$defs/sha256"},
    "specHash": {"$ref": "#/$defs/sha256"},
    "captureManifestSha256": {"$ref": "#/$defs/sha256"},
    "model": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
