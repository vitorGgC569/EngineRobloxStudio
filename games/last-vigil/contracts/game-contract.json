{
  "$schema": "../schemas/game-contract.schema.json",
  "schemaVersion": 1,
  "contractId": "last-vigil.release",
  "productId": "last-vigil",
  "productTruth": {
    "intentId": "last-vigil.intent",
    "semanticBindings": {
      "worldRoles": {
        "primary-landmark": [
          "world_primary_landmark"
        ]
      },
      "uiSurfaces": {
        "initial-interface": [
          "ui_initial_surface"
        ]
      },
      "gameplayVerbs": {
        "build": [
          "gameplay_build"
        ],
        "defend": [
          "gameplay_defend"
        ],
        "upgrade": [
          "gameplay_upgrade"
        ]
      }
    }
  },
  "game": {
    "name": "Last Vigil",
    "genre": "tower_defense",
    "max_players": 1,
    "target_devices": [
      "desktop",
      "phone"
    ]
  },
  "performance_budget": {
    "client": {
      "target_fps": 60,
      "max_frame_ms": 16.667
    },
    "instances": {
      "max_workspace": 25000
    },
    "mobile": {
      "mandatory": true
    }
  },
  "visualQuality": {
    "spec": "visual/visual-quality.json",
    "specId": "last-vigil.visual",
    "schemaMajor": 1,
    "required": true,
    "release": {
      "minimumScore": 100,
      "minimumRuleCoverage": 1,
      "minimumValidationLevel": "VISUALLY_VALIDATED",
      "missingEvidence": "FAIL"
    }
  },
  "release_gate": {
    "required_categories": [
      "structural",
      "assets",
      "security",
      "geometry",
      "navigation",
      "performance",
      "runtime",
      "ui",
      "gameplay",
      "visual",
      "persistence"
    ],
    "forbidden_sources": [
      "headless-runtime",
      "fixture"
    ],
    "minimum_requirement_coverage": 1,
    "minimum_category_coverage": {
      "structural": 1,
      "assets": 1,
      "security": 1,
      "geometry": 1,
      "navigation": 1,
      "performance": 1,
      "runtime": 1,
      "ui": 1,
      "gameplay": 1,
      "visual": 1,
      "persistence": 1
    },
    "minimum_validation_by_type": {
      "structural": "STATICALLY_VALIDATED",
      "security": "STATICALLY_VALIDATED",
      "geometry": "RUNTIME_VALIDATED",
      "navigation": "RUNTIME_VALIDATED",
      "runtime": "RUNTIME_VALIDATED",
      "performance": "RUNTIME_VALIDATED",
      "visual": "VISUALLY_VALIDATED",
      "ui": "E2E_VALIDATED",
      "gameplay": "E2E_VALIDATED",
      "persistence": "E2E_VALIDATED",
      "multiplayer": "E2E_VALIDATED"
    },
    "maximum_evidence_age_seconds_by_level": {
      "STATICALLY_VALIDATED": 3600,
      "RUNTIME_VALIDATED": 1800,
      "VISUALLY_VALIDATED": 1800,
      "E2E_VALIDATED": 1800
    },
    "minimum_visual_score": 100,
    "require_trustworthy_captures": true
  },
