    {
      "id": "structural_integrity",
      "probe": "structural_integrity",
      "type": "structural",
      "category": "structural",
      "severity": "critical",
      "validation": {
        "minimum_level": "STATICALLY_VALIDATED",
        "minimum_coverage": 1,
        "allowed_sources": [
