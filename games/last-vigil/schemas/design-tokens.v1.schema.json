{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/design-tokens.v1.schema.json",
  "title": "Design token set",
  "description": "The single source of truth for art direction. The builder reads it to construct, and the visual quality spec derives its thresholds from it. Because both sides read the same file, a spec can never be fitted to the candidate it grades.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "tokenSetId",
    "revision",
    "description",
    "provenance",
    "scale",
    "palette",
    "spacing",
    "typography",
    "motion",
    "moods",
    "cameras",
    "audio"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "tokenSetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 8},
    "provenance": {"$ref": "#/$defs/provenance"},
    "scale": {"$ref": "#/$defs/scale"},
    "palette": {"$ref": "#/$defs/palette"},
    "spacing": {"$ref": "#/$defs/spacing"},
    "typography": {"$ref": "#/$defs/typography"},
    "motion": {"$ref": "#/$defs/motion"},
    "moods": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/mood"}
    },
    "cameras": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/camera"}
    },
    "audio": {"$ref": "#/$defs/audio"}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation", "authoredBy", "authoredAt"],
      "description": "Where these numbers came from. 'measured-from-candidate' is deliberately absent as a legal value: a token set derived from the build it governs would make every threshold a tautology.",
      "properties": {
        "derivation": {
          "enum": ["external-reference", "platform-metrics", "art-direction-decision", "genre-convention"]
        },
        "authoredBy": {"type": "string", "minLength": 1},
        "authoredAt": {"type": "string", "minLength": 10},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["screenshot", "video", "document", "measurement", "specification"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "note": {"type": "string"}
            }
          }
        },
        "note": {"type": "string"}
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "grammar", "legibility"],
      "properties": {
        "character": {
          "type": "object",
          "additionalProperties": false,
          "required": ["height", "width", "walkSpeed", "jumpHeight", "maxStepUp", "comfortableSlopeDegrees"],
          "description": "Platform metrics. Everything in `grammar` is derived from these, which is what keeps a world from reading as a diorama.",
          "properties": {
            "height": {"type": "number", "exclusiveMinimum": 0},
            "width": {"type": "number", "exclusiveMinimum": 0},
            "walkSpeed": {"type": "number", "exclusiveMinimum": 0},
            "jumpHeight": {"type": "number", "exclusiveMinimum": 0},
            "maxStepUp": {"type": "number", "exclusiveMinimum": 0},
            "comfortableSlopeDegrees": {"type": "number", "exclusiveMinimum": 0, "maximum": 89}
          }
        },
        "grammar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doorWidth", "doorHeight", "corridorWidth", "ceilingHeight",
            "stairRise", "stairRun", "railHeight", "roomMinDimension",
            "buildingMinFootprint", "buildingMinHeight", "landmarkMinHeight",
            "plotMinDimension", "avenueWidth"
          ],
          "description": "Closed on purpose: a new metric must be added to the schema so both loaders agree on it.",
          "properties": {
            "doorWidth": {"type": "number", "exclusiveMinimum": 0},
            "doorHeight": {"type": "number", "exclusiveMinimum": 0},
            "corridorWidth": {"type": "number", "exclusiveMinimum": 0},
            "ceilingHeight": {"type": "number", "exclusiveMinimum": 0},
            "stairRise": {"type": "number", "exclusiveMinimum": 0},
            "stairRun": {"type": "number", "exclusiveMinimum": 0},
            "railHeight": {"type": "number", "exclusiveMinimum": 0},
            "roomMinDimension": {"type": "number", "exclusiveMinimum": 0},
            "buildingMinFootprint": {"type": "number", "exclusiveMinimum": 0},
            "buildingMinHeight": {"type": "number", "exclusiveMinimum": 0},
            "landmarkMinHeight": {"type": "number", "exclusiveMinimum": 0},
            "plotMinDimension": {"type": "number", "exclusiveMinimum": 0},
            "avenueWidth": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "legibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labelReadDistance", "signageReadDistance", "landmarkReadDistance", "silhouetteReadDistance"],
          "description": "Measured: 320 slot labels at MaxDistance 400 buried an entire map. A label appears when a player is close enough to act on the thing it names, and not before.",
          "properties": {
            "labelReadDistance": {"type": "number", "exclusiveMinimum": 0},
            "signageReadDistance": {"type": "number", "exclusiveMinimum": 0},
            "landmarkReadDistance": {"type": "number", "exclusiveMinimum": 0},
            "silhouetteReadDistance": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harmony", "roles"],
      "properties": {
        "harmony": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxHueFamilies", "minLightnessSpread", "accentTotalMaxCoverage", "maxDeltaEToNearestRole"],
          "properties": {
            "maxHueFamilies": {"type": "integer", "minimum": 1, "maximum": 12},
            "minLightnessSpread": {"type": "number", "minimum": 0, "maximum": 1},
            "accentTotalMaxCoverage": {"type": "number", "minimum": 0, "maximum": 1},
            "maxDeltaEToNearestRole": {"type": "number", "exclusiveMinimum": 0},
            "forbiddenMaterials": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "roles": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {"$ref": "#/$defs/paletteRole"}
        }
      }
    },
    "paletteRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["srgb", "material", "tier", "usage"],
      "properties": {
        "srgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "material": {"type": "string", "minLength": 1},
        "tier": {
          "enum": ["dominant", "supporting", "accent"],
          "description": "Coverage discipline, not decoration. An accent that covers a third of the world stops being an accent."
        },
        "usage": {"type": "string", "minLength": 4},
        "maxSurfaceCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "minSurfaceCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "reflectance": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "steps"],
      "properties": {
        "base": {"type": "number", "exclusiveMinimum": 0},
        "steps": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "base", "ratio", "steps", "weights"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "base": {"type": "number", "exclusiveMinimum": 0},
        "ratio": {"type": "number", "exclusiveMinimum": 1},
        "steps": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durations", "easings"],
      "properties": {
        "durations": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "easings": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["style", "direction"],
            "properties": {
              "style": {"type": "string", "minLength": 1},
              "direction": {"enum": ["In", "Out", "InOut"]}
            }
          }
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "lighting", "atmosphere", "post"],
      "properties": {
        "description": {"type": "string", "minLength": 4},
        "lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["technology", "brightness", "clockTime", "ambient", "outdoorAmbient", "exposureCompensation"],
          "properties": {
            "technology": {"enum": ["Voxel", "ShadowMap", "Future"]},
            "brightness": {"type": "number", "minimum": 0, "maximum": 10},
            "clockTime": {"type": "number", "minimum": 0, "maximum": 24},
            "geographicLatitude": {"type": "number", "minimum": -90, "maximum": 90},
            "ambient": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
            "outdoorAmbient": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
            "colorShiftTop": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
            "colorShiftBottom": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
            "exposureCompensation": {"type": "number", "minimum": -5, "maximum": 5},
            "environmentDiffuseScale": {"type": "number", "minimum": 0, "maximum": 1},
            "environmentSpecularScale": {"type": "number", "minimum": 0, "maximum": 1},
            "shadowSoftness": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "atmosphere": {
          "type": "object",
          "additionalProperties": false,
          "required": ["density", "offset", "haze", "glare"],
          "description": "The single strongest control for sense of scale and distance. A world without atmosphere reads as a tabletop no matter how large it is.",
          "properties": {
            "density": {"type": "number", "minimum": 0, "maximum": 1},
            "offset": {"type": "number", "minimum": -1, "maximum": 1},
            "haze": {"type": "number", "minimum": 0, "maximum": 10},
            "glare": {"type": "number", "minimum": 0, "maximum": 10},
            "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
            "decay": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
          }
        },
        "clouds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cover", "density"],
          "properties": {
            "cover": {"type": "number", "minimum": 0, "maximum": 1},
            "density": {"type": "number", "minimum": 0, "maximum": 1},
            "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
          }
        },
        "sky": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "starCount": {"type": "integer", "minimum": 0},
            "sunAngularSize": {"type": "number", "minimum": 0, "maximum": 90},
            "moonAngularSize": {"type": "number", "minimum": 0, "maximum": 90}
          }
        },
        "post": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bloom", "colorCorrection"],
          "properties": {
            "bloom": {
              "type": "object",
              "additionalProperties": false,
              "required": ["intensity", "size", "threshold"],
              "properties": {
                "intensity": {"type": "number", "minimum": 0, "maximum": 10},
                "size": {"type": "number", "minimum": 0, "maximum": 56},
                "threshold": {"type": "number", "minimum": 0, "maximum": 10}
              }
            },
            "colorCorrection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["brightness", "contrast", "saturation"],
              "properties": {
                "brightness": {"type": "number", "minimum": -1, "maximum": 1},
                "contrast": {"type": "number", "minimum": -1, "maximum": 1},
                "saturation": {"type": "number", "minimum": -1, "maximum": 1},
                "tintColor": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
              }
            },
            "sunRays": {
              "type": "object",
              "additionalProperties": false,
              "required": ["intensity", "spread"],
              "properties": {
                "intensity": {"type": "number", "minimum": 0, "maximum": 1},
                "spread": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "depthOfField": {
              "type": "object",
              "additionalProperties": false,
              "required": ["farIntensity", "focusDistance", "inFocusRadius", "nearIntensity"],
              "properties": {
                "farIntensity": {"type": "number", "minimum": 0, "maximum": 1},
                "focusDistance": {"type": "number", "minimum": 0},
                "inFocusRadius": {"type": "number", "minimum": 0},
                "nearIntensity": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "fieldOfView", "pitchDegrees", "distance", "heightOffset"],
      "properties": {
        "description": {"type": "string", "minLength": 4},
        "fieldOfView": {"type": "number", "exclusiveMinimum": 1, "maximum": 120},
        "pitchDegrees": {"type": "number", "minimum": -89, "maximum": 89},
        "distance": {"type": "number", "exclusiveMinimum": 0},
        "heightOffset": {"type": "number"},
        "minZoom": {"type": "number", "minimum": 0},
        "maxZoom": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buses", "spatial"],
      "properties": {
        "buses": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gainDb", "routing"],
            "properties": {
              "gainDb": {"type": "number", "minimum": -60, "maximum": 12},
              "routing": {"enum": ["device", "emitter"]},
              "description": {"type": "string"}
            }
          }
        },
        "spatial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultRolloffMin", "defaultRolloffMax"],
          "properties": {
            "defaultRolloffMin": {"type": "number", "exclusiveMinimum": 0},
            "defaultRolloffMax": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    }
  }
}
