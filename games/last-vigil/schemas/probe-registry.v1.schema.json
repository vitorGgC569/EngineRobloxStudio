{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/probe-registry.v1.schema.json",
  "title": "RQE release probe producer registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "producers"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "registryId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producerId", "probePattern", "status", "stage", "implementation",
          "source", "maximumValidationLevel", "releaseIntegrated", "contexts"
        ],
        "properties": {
          "producerId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
          "probePattern": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*(\\.\\*)?$"},
          "status": {"enum": ["AVAILABLE", "PARTIAL", "DISABLED", "FIXTURE_ONLY"]},
          "stage": {"enum": ["static", "build", "runtime", "scenario", "capture", "review"]},
          "implementation": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "maximumValidationLevel": {
            "enum": ["STATICALLY_VALIDATED", "RUNTIME_VALIDATED", "VISUALLY_VALIDATED", "E2E_VALIDATED"]
          },
          "releaseIntegrated": {"type": "boolean"},
          "contexts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["filesystem", "edit", "run", "server", "client", "desktop"]}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
