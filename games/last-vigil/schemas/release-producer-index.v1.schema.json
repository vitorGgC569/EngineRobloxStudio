{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/release-producer-index.v1.schema.json",
  "title": "RQE immutable release producer index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "runId", "buildHash", "placeHash", "specHash",
    "generatedAt", "producers", "evidenceIds", "commandErrorCount"
  ],
  "properties": {
    "$schema": {"const": "https://rqe.local/schemas/release-producer-index.v1.schema.json"},
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "buildHash": {"$ref": "#/$defs/hash"},
    "placeHash": {"$ref": "#/$defs/hash"},
    "specHash": {"$ref": "#/$defs/hash"},
    "generatedAt": {"type": "string", "minLength": 1},
    "producers": {
      "type": "array",
      "items": {"$ref": "#/$defs/producer"}
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "commandErrorCount": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerId", "status", "validationLevel", "artifacts", "evidenceIds", "issues"
      ],
      "properties": {
        "producerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "status": {"enum": ["COMPLETE", "BLOCKED"]},
        "validationLevel": {
          "enum": [
            "NOT_VALIDATED", "STATICALLY_VALIDATED", "RUNTIME_VALIDATED",
            "VISUALLY_VALIDATED", "E2E_VALIDATED"
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
