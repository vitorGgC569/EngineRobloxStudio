{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/asset-catalog.schema.json",
  "title": "RQE Asset Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "displayName", "description", "state", "provider", "requirement", "previews", "metadata"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["mesh", "audio", "animation", "icon"] },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "state": { "enum": ["draft", "validated", "uploading", "published", "approved", "rejected", "unavailable"] },
          "provider": { "type": "string", "minLength": 1 },
          "requirement": { "enum": ["production-required", "optional", "development"] },
          "previews": { "type": "array", "items": { "type": "object" } },
          "license": { "type": "object" },
          "provenance": { "type": "object" },
          "localPath": { "type": "string" },
          "contentType": { "type": "string" },
          "remoteAssetId": { "type": "string" },
          "moderationState": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  }
}
