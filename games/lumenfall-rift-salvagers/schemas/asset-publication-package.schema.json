{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/asset-publication-package.schema.json",
  "title": "RQE Asset Publication Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "provider", "createdAt", "creator", "asset", "integrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "creator": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["userId"],
          "properties": { "userId": { "type": "string", "minLength": 1 } }
        },
        {
          "additionalProperties": false,
          "required": ["groupId"],
          "properties": { "groupId": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": ["id", "kind", "displayName", "description", "state", "provider", "requirement", "previews", "metadata", "localPath", "contentType", "provenance"],
      "properties": {
        "state": { "const": "validated" },
        "provenance": {
          "type": "object",
          "required": ["contentSha256"],
          "properties": {
            "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "property"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "property": { "type": "string", "minLength": 1 },
          "expectedClass": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
