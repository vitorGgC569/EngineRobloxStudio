{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/evidence-report.v1.schema.json",
  "title": "Roblox Quality Engine Diagnostic Evidence Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine", "project", "generatedAt", "summary", "scores",
    "releaseAllowed", "releaseReasons", "evidence", "runtimeTrace",
    "staticScan", "agentSession"
  ],
  "properties": {
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "project": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}
    },
    "releaseAllowed": {"type": "boolean"},
    "releaseReasons": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/testResult"}},
    "runtimeTrace": {"type": "object"},
    "staticScan": {"type": "object"},
    "agentSession": {"type": "object"}
  },
  "$defs": {
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "probe", "category", "status", "severity", "message", "details",
        "source", "validationLevel", "observedAt", "runId", "buildHash",
        "coverage", "conclusive", "truncated"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "probe": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "WARN", "FAIL"]},
        "severity": {"enum": ["critical", "major", "minor", "info"]},
        "message": {"type": "string", "minLength": 1},
        "details": {"type": "object"},
        "source": {"type": "string", "minLength": 1},
        "validationLevel": {
          "enum": [
            "NOT_VALIDATED", "STATICALLY_VALIDATED", "RUNTIME_VALIDATED",
            "VISUALLY_VALIDATED", "E2E_VALIDATED"
          ]
        },
        "observedAt": {"type": ["string", "null"]},
        "runId": {"type": ["string", "null"]},
        "buildHash": {"type": ["string", "null"]},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "conclusive": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
