{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/production-blueprint-inspection.v1.schema.json",
  "title": "RQE Production Blueprint Inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reportType",
    "inspectionId",
    "authorizesRelease",
    "validationLevel",
    "blueprint",
    "engine",
    "summary",
    "projects",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "const": "rqe://schemas/production-blueprint-inspection.v1.schema.json"
    },
    "schemaVersion": {"const": 1},
    "reportType": {"const": "rqe.production-blueprint-inspection"},
    "inspectionId": {"$ref": "#/$defs/sha256"},
    "authorizesRelease": {"const": false},
    "validationLevel": {"const": "STATICALLY_VALIDATED"},
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engine": {"$ref": "#/$defs/engine"},
    "summary": {"$ref": "#/$defs/counts"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/project"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 256},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "version", "sourceRoots"],
      "properties": {
        "engineId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectTotal",
        "subsystemTotal",
        "assetNeedTotal",
        "scenarioClassTotal",
        "captureCombinationTotal",
        "qualityProfileTotal"
      ],
      "properties": {
        "projectTotal": {"type": "integer", "minimum": 1},
        "subsystemTotal": {"type": "integer", "minimum": 0},
        "assetNeedTotal": {"type": "integer", "minimum": 0},
        "scenarioClassTotal": {"type": "integer", "minimum": 0},
        "captureCombinationTotal": {"type": "integer", "minimum": 0},
        "qualityProfileTotal": {"type": "integer", "minimum": 0}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "productId",
        "definitionSha256",
        "sourceRoot",
        "artifactRoot",
        "subsystemTotal",
        "assetNeedTotal",
        "requiredAssetNeedTotal",
        "scenarioClassTotal",
        "requiredScenarioClassTotal",
        "captureCombinationTotal",
        "qualityProfileTotal",
        "requiredQualityProfileTotal",
        "outputKinds"
      ],
      "properties": {
        "projectId": {"type": "string", "minLength": 1},
        "productId": {"type": "string", "minLength": 1},
        "definitionSha256": {"$ref": "#/$defs/sha256"},
        "sourceRoot": {"$ref": "#/$defs/path"},
        "artifactRoot": {"$ref": "#/$defs/path"},
        "genre": {"type": "string", "minLength": 1},
        "templateId": {"type": "string", "minLength": 1},
        "subsystemTotal": {"type": "integer", "minimum": 0},
        "assetNeedTotal": {"type": "integer", "minimum": 0},
        "requiredAssetNeedTotal": {"type": "integer", "minimum": 0},
        "scenarioClassTotal": {"type": "integer", "minimum": 0},
        "requiredScenarioClassTotal": {"type": "integer", "minimum": 0},
        "captureCombinationTotal": {"type": "integer", "minimum": 0},
        "qualityProfileTotal": {"type": "integer", "minimum": 0},
        "requiredQualityProfileTotal": {"type": "integer", "minimum": 0},
        "outputKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
