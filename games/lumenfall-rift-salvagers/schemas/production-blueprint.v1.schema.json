{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/production-blueprint.v1.schema.json",
  "title": "RQE Production Blueprint v1",
  "description": "Engine-owned container for isolated Roblox game project definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blueprintId", "revision", "engine", "projects"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "blueprintId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "version", "sourceRoots"],
      "properties": {
        "engineId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 48},
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "object"}
    }
  }
}
