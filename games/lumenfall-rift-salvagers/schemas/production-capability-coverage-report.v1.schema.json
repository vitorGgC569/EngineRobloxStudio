{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rqe://schemas/production-capability-coverage-report.v1.schema.json",
  "title": "RQE production capability coverage report v1",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "reportType",
    "generatedAt",
    "authorizesRelease",
    "validationLevel",
    "integrityStatus",
    "productionReadiness",
    "catalog",
    "commandManifest",
    "summary",
    "phases",
    "bridgeCommands",
    "adapters",
    "gaps",
    "issues"
  ],
  "properties": {
    "$schema": {"const": "rqe://schemas/production-capability-coverage-report.v1.schema.json"},
    "schemaVersion": {"const": 1},
    "reportType": {"const": "rqe.production-capability-coverage"},
    "generatedAt": {"type": "string", "minLength": 1},
    "authorizesRelease": {"const": false},
    "validationLevel": {"enum": ["NOT_VALIDATED", "STATICALLY_VALIDATED"]},
    "integrityStatus": {"enum": ["PASS", "BLOCKED"]},
    "productionReadiness": {"enum": ["READY", "INCOMPLETE"]},
    "catalog": {"$ref": "#/$defs/catalogIdentity"},
    "commandManifest": {"$ref": "#/$defs/commandIdentity"},
    "summary": {
      "type": "object",
      "required": [
        "phaseTotal",
        "capabilityTotal",
        "capabilityByStatus",
        "readyCapabilityTotal",
        "readyCapabilityCoverage",
        "bridgeCommandTotal",
        "mappedBridgeCommandTotal",
        "bridgeCommandCoverage",
        "unsupportedBridgeCommandTotal",
        "adapterTotal",
        "resolvedAdapterTotal",
        "adapterCoverage"
      ],
      "properties": {
        "phaseTotal": {"type": "integer", "minimum": 1},
        "capabilityTotal": {"type": "integer", "minimum": 1},
        "capabilityByStatus": {
          "type": "object",
          "required": ["AVAILABLE", "PARTIAL", "BLOCKED", "GAP", "UNSUPPORTED"],
          "properties": {
            "AVAILABLE": {"type": "integer", "minimum": 0},
            "PARTIAL": {"type": "integer", "minimum": 0},
            "BLOCKED": {"type": "integer", "minimum": 0},
            "GAP": {"type": "integer", "minimum": 0},
            "UNSUPPORTED": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "readyCapabilityTotal": {"type": "integer", "minimum": 0},
        "readyCapabilityCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "bridgeCommandTotal": {"type": "integer", "minimum": 0},
        "mappedBridgeCommandTotal": {"type": "integer", "minimum": 0},
        "bridgeCommandCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "unsupportedBridgeCommandTotal": {"type": "integer", "minimum": 0},
        "adapterTotal": {"type": "integer", "minimum": 0},
        "resolvedAdapterTotal": {"type": "integer", "minimum": 0},
        "adapterCoverage": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "capabilityIds", "capabilityCount", "readyCapabilityCount", "statuses", "productionReady"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "capabilityIds": {"type": "array", "items": {"type": "string"}},
          "capabilityCount": {"type": "integer", "minimum": 1},
          "readyCapabilityCount": {"type": "integer", "minimum": 0},
          "statuses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "productionReady": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "bridgeCommands": {
      "type": "object",
      "required": ["mapped", "unmapped", "unknown", "unsupported"],
      "properties": {
        "mapped": {"$ref": "#/$defs/strings"},
        "unmapped": {"$ref": "#/$defs/strings"},
        "unknown": {"$ref": "#/$defs/strings"},
        "unsupported": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "resolved", "source", "line", "error", "roles", "capabilityIds", "required"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "resolved": {"type": "boolean"},
          "source": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]},
          "error": {"type": ["string", "null"]},
          "roles": {"$ref": "#/$defs/strings"},
          "capabilityIds": {"$ref": "#/$defs/strings"},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capabilityId", "phase", "status", "items"],
        "properties": {
          "capabilityId": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "items": {"$ref": "#/$defs/strings"}
        },
        "additionalProperties": false
      }
    },
    "issues": {"$ref": "#/$defs/issues"}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "catalogIdentity": {
      "type": "object",
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "commandIdentity": {
      "type": "object",
      "required": ["path", "sha256", "schemaVersion", "protocol"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schemaVersion": {"type": "integer", "minimum": 1},
        "protocol": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
