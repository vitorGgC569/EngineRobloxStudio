{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Agent Action",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"type": "string", "enum": ["keyboard", "keyboard_sequence", "key_down", "key_up", "mouse_move", "mouse_click", "look", "jump", "walk_to", "interact", "wait", "open_inventory", "click_button"]},
    "key": {"type": "string"},
    "keys": {"type": "array", "items": {"type": "string"}},
    "duration_ms": {"type": "number", "minimum": 0},
    "target": {"type": "string"},
    "controller": {"enum": ["human", "pathfinding", "direct"]}
  }
}
