{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/game-project-definition.v1.schema.json",
  "title": "RQE Game Project Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "productId",
    "revision",
    "seed",
    "sourceRoot",
    "artifactRoot",
    "productIntentRef",
    "referenceBundleRef",
    "subsystems",
    "ownership",
    "deviceViewpointMatrix",
    "scenarioClasses",
    "assetNeeds",
    "qualityProfiles",
    "outputArtifactRefs"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "projectId": {"$ref": "#/$defs/longId"},
    "productId": {"$ref": "#/$defs/productId"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "genre": {"type": "string", "minLength": 1, "maxLength": 64},
    "templateId": {"$ref": "#/$defs/longId"},
    "sourceRoot": {"$ref": "#/$defs/repositoryPath"},
    "artifactRoot": {"$ref": "#/$defs/repositoryPath"},
    "productIntentRef": {"$ref": "#/$defs/inputArtifactRef"},
    "referenceBundleRef": {"$ref": "#/$defs/inputArtifactRef"},
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/subsystem"}
    },
    "ownership": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ownershipRule"}
    },
    "deviceViewpointMatrix": {"$ref": "#/$defs/deviceViewpointMatrix"},
    "scenarioClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenarioClass"}
    },
    "assetNeeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assetNeed"}
    },
    "qualityProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/qualityProfile"}
    },
    "outputArtifactRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/outputArtifactRef"}
    }
  },
  "$defs": {
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
    },
    "shortId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
    },
    "longId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "artifactId", "kind", "path", "sha256"],
      "properties": {
        "productId": {"$ref": "#/$defs/productId"},
        "artifactId": {"$ref": "#/$defs/longId"},
        "kind": {
          "enum": ["PRODUCT_INTENT", "REFERENCE_BUNDLE", "QUALITY_PROFILE"]
        },
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "outputArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "artifactId", "kind", "path"],
      "properties": {
        "productId": {"$ref": "#/$defs/productId"},
        "artifactId": {"$ref": "#/$defs/longId"},
        "kind": {
          "enum": [
            "PRODUCTION_PLAN",
            "SOURCE_BUNDLE",
            "ASSET_MANIFEST",
            "BUILD_PLACE",
            "INTEGRATION_MANIFEST",
            "MEASUREMENT_RUN",
            "SCENARIO_RESULTS",
            "CAPTURE_BUNDLE",
            "QUALITY_REVIEW",
            "REPAIR_PLAN",
            "REGRESSION_RUN",
            "RELEASE_CANDIDATE"
          ]
        },
        "path": {"$ref": "#/$defs/repositoryPath"}
      }
    },
    "subsystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "dependencies"],
      "properties": {
        "id": {"$ref": "#/$defs/shortId"},
        "capability": {"type": "string", "minLength": 1, "maxLength": 160},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shortId"}
        }
      }
    },
    "ownershipRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subsystemId", "ownerRole", "writeRoots"],
      "properties": {
        "subsystemId": {"$ref": "#/$defs/shortId"},
        "ownerRole": {"type": "string", "minLength": 1, "maxLength": 64},
        "writeRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewportWidth", "viewportHeight", "inputModes"],
      "properties": {
        "id": {"$ref": "#/$defs/shortId"},
        "viewportWidth": {"type": "integer", "minimum": 240, "maximum": 7680},
        "viewportHeight": {"type": "integer", "minimum": 240, "maximum": 4320},
        "inputModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["KEYBOARD_MOUSE", "TOUCH", "GAMEPAD"]}
        }
      }
    },
    "viewpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "cameraMode"],
      "properties": {
        "id": {"$ref": "#/$defs/shortId"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 160},
        "cameraMode": {"enum": ["FIXED", "PLAYER", "SUBJECT", "SCRIPTED"]}
      }
    },
    "captureCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "viewpointId"],
      "properties": {
        "deviceId": {"$ref": "#/$defs/shortId"},
        "viewpointId": {"$ref": "#/$defs/shortId"}
      }
    },
    "deviceViewpointMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devices", "viewpoints", "combinations"],
      "properties": {
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/device"}
        },
        "viewpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/viewpoint"}
        },
        "combinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/captureCombination"}
        }
      }
    },
    "scenarioClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "requiredForRelease", "actorProfile"],
      "properties": {
        "id": {"$ref": "#/$defs/shortId"},
        "class": {
          "enum": [
            "ONBOARDING",
            "CORE_LOOP",
            "PROGRESSION",
            "FAILURE",
            "REJOIN",
            "MULTIPLAYER",
            "MONETIZATION"
          ]
        },
        "requiredForRelease": {"type": "boolean"},
        "actorProfile": {"$ref": "#/$defs/longId"}
      }
    },
    "assetNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "strategy", "requiredForRelease", "consumers"],
      "properties": {
        "id": {"$ref": "#/$defs/shortId"},
        "type": {"enum": ["MESH", "AUDIO", "ANIMATION", "ICON", "IMAGE", "MODEL"]},
        "strategy": {"enum": ["DISCOVER", "CREATE", "EITHER"]},
        "requiredForRelease": {"type": "boolean"},
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shortId"}
        },
        "acceptanceProfileId": {"$ref": "#/$defs/shortId"}
      }
    },
    "qualityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredForRelease", "appliesTo", "inputRef"],
      "properties": {
        "id": {"$ref": "#/$defs/shortId"},
        "requiredForRelease": {"type": "boolean"},
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "STRUCTURAL",
              "RUNTIME",
              "GAMEPLAY",
              "VISUAL",
              "ASSETS",
              "PERFORMANCE",
              "ACCESSIBILITY",
              "RELEASE"
            ]
          }
        },
        "inputRef": {"$ref": "#/$defs/inputArtifactRef"}
      }
    }
  }
}
