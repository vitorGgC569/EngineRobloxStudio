{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/production-plan.v1.schema.json",
  "title": "RQE Deterministic Production Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "blueprintId",
    "blueprintSha256",
    "validationLevel",
    "engine",
    "projects",
    "planSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "planId": {"type": "string", "minLength": 1, "maxLength": 128},
    "blueprintId": {"type": "string", "minLength": 1, "maxLength": 48},
    "blueprintSha256": {"$ref": "#/$defs/sha256"},
    "validationLevel": {"const": "STATICALLY_VALIDATED"},
    "engine": {"$ref": "#/$defs/engine"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPlan"}
    },
    "planSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 256},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "version", "sourceRoots"],
      "properties": {
        "engineId": {"type": "string", "minLength": 1, "maxLength": 48},
        "version": {"type": "string", "minLength": 1, "maxLength": 48},
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "stage",
        "role",
        "intent",
        "dependsOn",
        "readSet",
        "writeSet",
        "resourceClaims",
        "completionChecks",
        "guardRequired",
        "metadata"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "stage": {
          "enum": [
            "CREATED",
            "SPECIFYING",
            "PLANNED",
            "BUILDING",
            "INTEGRATING",
            "MEASURING",
            "PLAYING",
            "CAPTURING",
            "EVALUATING",
            "REPAIRING",
            "REGRESSION_IMPACTED",
            "REGRESSION_FULL",
            "RELEASED",
            "BLOCKED",
            "INFRA_FAILED",
            "CANCELLED"
          ]
        },
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "intent": {"type": "string", "minLength": 1, "maxLength": 240},
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 96}
        },
        "readSet": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "writeSet": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "resourceClaims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "completionChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "guardRequired": {"type": "boolean"},
        "metadata": {"type": "object"}
      }
    },
    "projectPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "productId", "projectDefinitionSha256", "tasks"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1, "maxLength": 48},
        "productId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
        },
        "projectDefinitionSha256": {"$ref": "#/$defs/sha256"},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/task"}
        }
      }
    }
  }
}
