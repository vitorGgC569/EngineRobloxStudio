{
  "$schema": "../schemas/probe-registry.v1.schema.json",
  "schemaVersion": 1,
  "registryId": "rqe.release-producers",
  "producers": [
    {"producerId": "static.project-topology", "probePattern": "structural_integrity", "status": "AVAILABLE", "stage": "static", "implementation": "rqe.scanner:scan_structure", "source": "filesystem", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": true, "contexts": ["filesystem"]},
    {"producerId": "static.contract-schema", "probePattern": "contract_schema", "status": "AVAILABLE", "stage": "static", "implementation": "rqe.release:_static_evidence", "source": "contract-validator", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": true, "contexts": ["filesystem"]},
    {"producerId": "static.fixture-exclusion", "probePattern": "fixture_excluded", "status": "AVAILABLE", "stage": "static", "implementation": "rqe.release:_static_evidence", "source": "release-orchestrator", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": true, "contexts": ["filesystem"]},
    {"producerId": "static.visual-spec-schema", "probePattern": "visual_spec_schema", "status": "AVAILABLE", "stage": "static", "implementation": "rqe.release:_static_evidence", "source": "visual-spec-validator", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": true, "contexts": ["filesystem"]},
    {"producerId": "static.asset-security", "probePattern": "asset_security", "status": "AVAILABLE", "stage": "static", "implementation": "rqe.release:_static_evidence", "source": "release-static-validator", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": true, "contexts": ["filesystem"]},
    {"producerId": "static.visual-assets", "probePattern": "visual_asset_quality", "status": "AVAILABLE", "stage": "static", "implementation": "rqe.scanner:scan_structure", "source": "visual-asset-validator", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": true, "contexts": ["filesystem"]},

    {"producerId": "runtime.performance-budget", "probePattern": "performance_budget", "status": "AVAILABLE", "stage": "runtime", "implementation": "rqe.observe:_measure_runtime", "source": "studio-bridge", "maximumValidationLevel": "RUNTIME_VALIDATED", "releaseIntegrated": true, "contexts": ["run", "server"]},
    {"producerId": "runtime.output-errors", "probePattern": "runtime_error", "status": "AVAILABLE", "stage": "runtime", "implementation": "rqe.observe:_measure_logs", "source": "studio-bridge", "maximumValidationLevel": "RUNTIME_VALIDATED", "releaseIntegrated": true, "contexts": ["run", "server", "client"]},
    {"producerId": "runtime.objective-navigation", "probePattern": "objective_reachable", "status": "AVAILABLE", "stage": "runtime", "implementation": "rqe.observe:_measure_navigation", "source": "studio-bridge", "maximumValidationLevel": "RUNTIME_VALIDATED", "releaseIntegrated": true, "contexts": ["run", "server"]},
    {"producerId": "runtime.ground-support-diagnostic", "probePattern": "ground_support", "status": "AVAILABLE", "stage": "runtime", "implementation": "rqe.observe:_measure_world", "source": "studio-bridge", "maximumValidationLevel": "RUNTIME_VALIDATED", "releaseIntegrated": true, "contexts": ["run", "server"]},
    {"producerId": "runtime.product-truth", "probePattern": "product_truth_alignment", "status": "AVAILABLE", "stage": "runtime", "implementation": "rqe.release:_evaluate_product_truth", "source": "product-truth-validator", "maximumValidationLevel": "RUNTIME_VALIDATED", "releaseIntegrated": true, "contexts": ["edit", "run", "server"]},

    {"producerId": "quality.snapshot-validator", "probePattern": "visual.*", "status": "PARTIAL", "stage": "runtime", "implementation": "rqe.quality:validate_quality_snapshot", "source": "studio-quality-validator", "maximumValidationLevel": "RUNTIME_VALIDATED", "releaseIntegrated": false, "contexts": ["run", "server"], "notes": "validator exists, but no typed Studio snapshot command is wired into release"},
    {"producerId": "quality.studio-capture", "probePattern": "visual.viewpoint.*", "status": "PARTIAL", "stage": "capture", "implementation": "rqe.capture:capture_set", "source": "studio-capture", "maximumValidationLevel": "VISUALLY_VALIDATED", "releaseIntegrated": false, "contexts": ["desktop"], "notes": "capture integrity exists, but release has no capture call-site"},
    {"producerId": "quality.visual-review", "probePattern": "visual.*", "status": "PARTIAL", "stage": "review", "implementation": "rqe.visual_review:review_captures", "source": "visual-review", "maximumValidationLevel": "VISUALLY_VALIDATED", "releaseIntegrated": false, "contexts": ["filesystem"], "notes": "provider-neutral reviewer exists, but release has no configured live provider"},

    {"producerId": "legacy.fixture-probes", "probePattern": "card_gallery", "status": "FIXTURE_ONLY", "stage": "static", "implementation": "rqe.probes:run_probes", "source": "headless-runtime", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": false, "contexts": ["filesystem"], "notes": "the only implementation reads the forbidden hand-written fixture"},
    {"producerId": "legacy.source-previews", "probePattern": "visual_snapshot_bundle", "status": "DISABLED", "stage": "static", "implementation": "rqe.scanner:scan_structure", "source": "visual-snapshot-validator", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": false, "contexts": ["filesystem"], "notes": "candidate-authored source previews are not release evidence"},
    {"producerId": "legacy.studio-detector", "probePattern": "studio_runtime_capture", "status": "DISABLED", "stage": "static", "implementation": "rqe.studio:detect_studio", "source": "studio-detector", "maximumValidationLevel": "STATICALLY_VALIDATED", "releaseIntegrated": false, "contexts": ["filesystem"], "notes": "legacy detector can combine a live process with a stale manifest"}
  ]
}
