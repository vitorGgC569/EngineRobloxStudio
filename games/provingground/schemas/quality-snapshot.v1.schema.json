{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/quality-snapshot.v1.schema.json",
  "title": "RQE Studio visual quality snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capturedAt", "truncated", "classification", "roots", "regions", "visibility"],
  "properties": {
    "schemaVersion": {"const": 1},
    "capturedAt": {"type": "string", "minLength": 1},
    "truncated": {"type": "boolean"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "classified", "excluded"],
      "properties": {
        "eligible": {"type": "integer", "minimum": 0},
        "classified": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "roots": {"type": "array", "items": {"$ref": "#/$defs/root"}},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "visibility": {"type": "array", "items": {"$ref": "#/$defs/visibility"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "vector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "positiveVector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "rgb": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "obb": {
      "type": "object", "additionalProperties": false,
      "required": ["center", "size", "right", "up", "back"],
      "properties": {
        "center": {"$ref": "#/$defs/vector3"},
        "size": {"$ref": "#/$defs/positiveVector3"},
        "right": {"$ref": "#/$defs/vector3"},
        "up": {"$ref": "#/$defs/vector3"},
        "back": {"$ref": "#/$defs/vector3"}
      }
    },
    "surfaceMaterial": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "surfaceArea"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "surfaceArea": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "surfaceColor": {
      "type": "object", "additionalProperties": false,
      "required": ["rgb", "surfaceArea"],
      "properties": {
        "rgb": {"$ref": "#/$defs/rgb"},
        "surfaceArea": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "path", "type", "variant", "obb", "materials", "colors"],
      "properties": {
        "ref": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/id"},
        "type": {"$ref": "#/$defs/id"},
        "variant": {"$ref": "#/$defs/id"},
        "assetKey": {"$ref": "#/$defs/id"},
        "obb": {"$ref": "#/$defs/obb"},
        "materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surfaceMaterial"}},
        "colors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surfaceColor"}}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "path", "profile", "obb"],
      "properties": {
        "ref": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/id"},
        "profile": {"$ref": "#/$defs/id"},
        "obb": {"$ref": "#/$defs/obb"}
      }
    },
    "visibility": {
      "type": "object", "additionalProperties": false,
      "required": ["landmarkId", "regionRef", "sampled", "visible", "visibleFraction", "maximumBlindSpotDegrees", "conclusive"],
      "properties": {
        "landmarkId": {"$ref": "#/$defs/id"},
        "regionRef": {"$ref": "#/$defs/id"},
        "sampled": {"type": "integer", "minimum": 1},
        "visible": {"type": "integer", "minimum": 0},
        "visibleFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "maximumBlindSpotDegrees": {"type": "number", "minimum": 0, "maximum": 360},
        "conclusive": {"type": "boolean"}
      }
    }
  }
}
