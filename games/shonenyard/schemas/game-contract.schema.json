{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/game-contract.v1.schema.json",
  "title": "Roblox Quality Engine Game Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "game", "performance_budget", "visualQuality", "release_gate", "requirements"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "contractId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "productId": {"$ref": "#/$defs/qualifiedId"},
    "productTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentId", "semanticBindings"],
      "properties": {
        "intentId": {"$ref": "#/$defs/qualifiedId"},
        "semanticBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worldRoles", "uiSurfaces", "gameplayVerbs"],
          "properties": {
            "worldRoles": {"$ref": "#/$defs/semanticRequirementBindings"},
            "uiSurfaces": {"$ref": "#/$defs/semanticRequirementBindings"},
            "gameplayVerbs": {"$ref": "#/$defs/semanticRequirementBindings"}
          }
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "genre", "max_players", "target_devices"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "genre": {"type": "string", "minLength": 1},
        "max_players": {"type": "integer", "minimum": 1, "maximum": 100},
        "target_devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["desktop", "phone", "tablet", "console", "vr"]}
        }
      }
    },
    "performance_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "instances", "mobile"],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_fps", "max_frame_ms"],
          "properties": {
            "target_fps": {"type": "number", "exclusiveMinimum": 0},
            "max_frame_ms": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "instances": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_workspace"],
          "properties": {"max_workspace": {"type": "integer", "minimum": 1}}
        },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mandatory"],
          "properties": {"mandatory": {"type": "boolean"}}
        }
      }
    },
    "visualQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "specId", "schemaMajor", "required", "release"],
      "properties": {
        "spec": {"type": "string", "minLength": 1},
        "specId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
        "schemaMajor": {"const": 1},
        "required": {"const": true},
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumScore", "minimumRuleCoverage", "minimumValidationLevel", "missingEvidence"],
          "properties": {
            "minimumScore": {"type": "number", "minimum": 0, "maximum": 100},
            "minimumRuleCoverage": {"type": "number", "minimum": 0, "maximum": 1},
            "minimumValidationLevel": {"const": "VISUALLY_VALIDATED"},
            "missingEvidence": {"const": "FAIL"}
          }
        }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_categories", "forbidden_sources", "minimum_requirement_coverage", "minimum_category_coverage", "minimum_validation_by_type", "maximum_evidence_age_seconds_by_level", "minimum_visual_score", "require_trustworthy_captures"],
      "properties": {
        "required_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "minimum_requirement_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_category_coverage": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "minimum_validation_by_type": {"type": "object", "additionalProperties": {"$ref": "#/$defs/positiveValidationLevel"}},
        "maximum_evidence_age_seconds_by_level": {
          "type": "object",
          "additionalProperties": false,
          "required": ["STATICALLY_VALIDATED", "RUNTIME_VALIDATED", "VISUALLY_VALIDATED", "E2E_VALIDATED"],
          "properties": {
            "STATICALLY_VALIDATED": {"type": "number", "exclusiveMinimum": 0},
            "RUNTIME_VALIDATED": {"type": "number", "exclusiveMinimum": 0},
            "VISUALLY_VALIDATED": {"type": "number", "exclusiveMinimum": 0},
            "E2E_VALIDATED": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "minimum_visual_score": {"type": "number", "minimum": 0, "maximum": 100},
        "require_trustworthy_captures": {"type": "boolean"}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "probe", "type", "severity"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "probe": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"enum": ["structural", "security", "visual", "geometry", "gameplay", "scenario", "navigation", "ui", "runtime", "performance", "persistence", "multiplayer"]},
          "category": {"type": "string"},
          "severity": {"enum": ["critical", "major", "minor", "info"]},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "devices": {"type": "array", "items": {"type": "string"}},
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum_level": {"$ref": "#/$defs/positiveValidationLevel"},
              "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "maximum_age_seconds": {"type": "number", "exclusiveMinimum": 0},
              "allowed_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "qualifiedId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "semanticRequirementBindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "positiveValidationLevel": {
      "enum": ["STATICALLY_VALIDATED", "RUNTIME_VALIDATED", "VISUALLY_VALIDATED", "E2E_VALIDATED"]
    }
  }
}
