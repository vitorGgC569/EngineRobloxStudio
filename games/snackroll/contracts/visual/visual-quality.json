      }
    },
    "plant": {
      "selector": {
        "tag": "RQEVisualRoot",
        "attributeEquals": {
          "VisualType": "plant"
        }
      },
      "minimumInstances": 12,
      "scale": {
        "boundsMethod": "oriented-box",
