    "play-regions": {
      "selector": {
        "tag": "RQEVisualRegion",
        "attributeEquals": {
          "VisualRegionProfile": "arena"
        }
      },
      "profile": "arena",
      "minimumRegions": 1,
      "maximumRegions": 4,
      "minimumProfileCoverage": 1
    }
  },
  "landmarks": {
    "arena-ring": {
      "selector": {
        "tag": "RQELandmark",
        "attributeEquals": {
          "LandmarkId": "arena-ring"
        }
      },
      "anchorSelector": {
        "tag": "RQELandmarkAnchor",
        "attributeEquals": {
          "LandmarkId": "arena-ring"
        }
      },
      "maximumDistance": 400.0,
      "sampleSpacing": 12,
      "eyeHeight": 5,
      "raysPerAnchor": 9,
      "minimumVisibleAnchorFraction": 0.5,
      "maximumBlindSpotDegrees": 60,
      "minimumRegionsVisibleFrom": 1
    }
