{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rqe.local/schemas/visual-calibration-receipt.v1.schema.json",
  "title": "RQE Visual Calibration Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "calibrationId", "revision", "productId",
    "benchmark", "methodology", "thresholds"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "calibrationId": {"$ref": "#/$defs/qualifiedId"},
    "revision": {"type": "integer", "minimum": 1},
    "productId": {"$ref": "#/$defs/qualifiedId"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmarkId", "sha256"],
      "properties": {
        "benchmarkId": {"$ref": "#/$defs/qualifiedId"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibratedAt", "calibratedBy", "freezeBeforeCandidateEvaluation",
        "candidateInputsUsed", "method"
      ],
      "properties": {
        "calibratedAt": {"$ref": "#/$defs/timestamp"},
        "calibratedBy": {"type": "string", "minLength": 1, "maxLength": 200},
        "freezeBeforeCandidateEvaluation": {"const": true},
        "candidateInputsUsed": {"const": false},
        "method": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "thresholds": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/threshold"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "qualifiedId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholdId", "metricId", "scope", "targetArtifact", "targetPointer",
        "operator", "value", "unit", "candidateDerived", "provenance"
      ],
      "properties": {
        "thresholdId": {"$ref": "#/$defs/id"},
        "metricId": {"$ref": "#/$defs/qualifiedId"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 500},
        "targetArtifact": {"enum": ["contract", "visualQualitySpec"]},
        "targetPointer": {"type": "string", "pattern": "^/"},
        "operator": {"enum": ["gte", "lte", "eq"]},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 100},
        "candidateDerived": {"const": false},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "benchmarkId", "benchmarkSha256", "sourceObservationIds",
            "derivationMethod", "derivationParameters", "tool", "toolVersion",
            "derivedAt", "derivedBy", "candidateDerived"
          ],
          "properties": {
            "benchmarkId": {"$ref": "#/$defs/qualifiedId"},
            "benchmarkSha256": {"$ref": "#/$defs/sha256"},
            "sourceObservationIds": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "derivationMethod": {
              "enum": [
                "reference-minimum", "reference-maximum", "reference-mean",
                "reference-quantile", "reference-range", "director-margin-over-reference"
              ]
            },
            "derivationParameters": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number", "boolean"]}
            },
            "tool": {"type": "string", "minLength": 1, "maxLength": 200},
            "toolVersion": {"type": "string", "minLength": 1, "maxLength": 100},
            "derivedAt": {"$ref": "#/$defs/timestamp"},
            "derivedBy": {"type": "string", "minLength": 1, "maxLength": 200},
            "candidateDerived": {"const": false}
          }
        }
      }
    }
  }
}
